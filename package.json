{
  "name": "interleaf",
  "private": true,
  "description": "Merge, reorder, fill and export PDFs in your browser. Files never leave your device.",
  "license": "MIT",
  "homepage": "https://www.interleaf.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abijith-suresh/interleaf.git"
  },
  "bugs": {
    "url": "https://github.com/abijith-suresh/interleaf/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.1",
  "version": "0.0.15",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:qpdf-wasm": "./tools/qpdf-wasm/build-qpdf-wasm.sh",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "bun run build && bun run test:e2e",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.6",
    "astro": "^7.4.12",
    "effect": "4.1.4",
    "fflate": "^0.8.3",
    "lucide-solid": "1.73.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.5",
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@effect/vitest": "4.1.4",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "satori": "^0.63.2",
    "typescript": "6",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.0"
  }
}
