{
  "name": "interleaf",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "version": "0.0.11",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:qpdf-wasm": "./tools/qpdf-wasm/build-qpdf-wasm.sh",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro sync && astro check && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "bun run build && bun run test:e2e",
    "verify": "bun run type-check && bun run lint && bun run format:check && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@embedpdf/pdfium": "2.15.1",
    "@fontsource/work-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.8",
    "effect": "4.0.2",
    "fflate": "^0.8.3",
    "satori": "^0.44.3",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@effect/vitest": "4.0.2",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "typescript": "6",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  }
}
