# Normalize line endings to LF
* text=auto eol=lf

# Denote files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.lock -diff

# GitHub linguist overrides
.changeset/** linguist-generated=true
CHANGELOG.md linguist-generated=true
