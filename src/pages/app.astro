---
import Layout from "../layouts/Layout.astro";
import Editor from "../components/app/Editor";
---

<Layout
  title="Interleaf — Editor"
  description="Open your PDF and start editing. Merge, split, reorder, rotate, and delete pages — all client-side, nothing leaves your device."
>
  <main data-page="editor" transition:animate="none">
    <Editor client:only="solid-js" />
  </main>
</Layout>

<style is:global>
  body:has([data-page="editor"]) {
    margin: 0;
    padding: 0;
    height: 100%;
    overflow: hidden;
  }

  /* Page thumbnails — Swiss industrial style */
  .editor-page {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fff;
    user-select: none;
  }

  .editor-page-hitarea {
    width: 100%;
    padding: 0;
    border: none;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }

  .editor-page-hitarea:disabled {
    cursor: not-allowed;
  }

  .editor-page-hitarea:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .editor-page.selected {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .editor-page.selected::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    z-index: 1;
  }

  .editor-page.marked-deleted {
    opacity: 0.4;
  }

  .editor-page.marked-deleted::after {
    content: "DELETED";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(255, 255, 255, 0.6);
    color: var(--color-accent);
    font-size: 8px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 6px;
    pointer-events: none;
    z-index: 1;
  }

  .editor-page.dragging {
    opacity: 0.3;
    cursor: grabbing;
  }

  /* Directional insertion indicator — shows where the dropped page will land */
  .editor-page.drag-insert-before {
    box-shadow: -3px 0 0 0 var(--color-accent);
  }

  .editor-page.drag-insert-after {
    box-shadow: 3px 0 0 0 var(--color-accent);
  }

  .canvas-container {
    aspect-ratio: 3 / 4;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }

  /* Landscape aspect-ratio for pages rotated 90° or 270° */
  .canvas-container.is-transposed {
    aspect-ratio: 4 / 3;
  }

  /* Placeholder shown while the canvas has not yet been painted */
  .canvas-container.thumbnail-placeholder {
    background: var(--color-placeholder);
  }

  .editor-page:hover .canvas-container {
    border-color: var(--color-primary);
  }

  .editor-page .page-canvas {
    max-width: 100%;
    max-height: 100%;
    /* Fade back in after re-render */
    transition: opacity 120ms ease-out;
  }

  /* Applied during rotation re-render — canvas fades out, reshapes, fades in */
  .editor-page .page-canvas.is-rendering {
    opacity: 0;
    transition: opacity 80ms ease-in;
  }

  .page-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 4px;
    padding: 0;
  }

  .page-controls .page-label {
    font-size: 9px;
  }

  .btn-page-rotate {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 10px;
    padding: 0;
    color: var(--color-border);
    opacity: 0;
    transition:
      opacity 0.2s,
      color 0.2s;
  }

  .editor-page:hover .btn-page-rotate {
    opacity: 1;
  }

  .btn-page-rotate:hover {
    color: var(--color-muted);
  }
</style>
