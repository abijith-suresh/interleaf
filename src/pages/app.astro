---
import Layout from "../layouts/Layout.astro";
import Editor from "../components/app/Editor";
import "../styles/editor.css";
---

<Layout
  title="Interleaf — Editor"
  description="Open a PDF or create one from PNG/JPEG images, then merge, review, extract, reorder, rotate, mark pages for deletion before export, export pages as images, unlock PDFs, or losslessly compress an untouched PDF. All processing happens client-side, so nothing leaves your device."
>
  <main id="main-content" data-page="editor" transition:animate="none">
    <Editor client:only="solid-js" />
  </main>
</Layout>
