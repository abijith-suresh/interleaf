---
import Layout from "../layouts/Layout.astro";
import Editor from "../components/app/Editor";
import "../styles/editor.css";
---

<Layout
  title="Editor — Interleaf"
  description="Open PDFs and PNG or JPEG images, review and shape their pages, and export a PDF or PNG images. Unlock protected files. Everything runs in your browser, and nothing is uploaded."
>
  <link
    slot="head"
    rel="preload"
    href={`${import.meta.env.BASE_URL}fonts/source-serif-4-latin-opsz-normal.woff2`}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <main id="main-content" data-page="editor" transition:animate="none">
    <Editor client:only="solid-js" />
  </main>
</Layout>
