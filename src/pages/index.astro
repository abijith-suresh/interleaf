---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/shared/Nav.astro";
import Footer from "../components/shared/Footer.astro";
import NumberedRow from "../components/shared/NumberedRow.astro";
import BottomCTA from "../components/shared/BottomCTA.astro";
import { contentSlide } from "../utils/transitions";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Interleaf - Client-Side PDF Editor"
  description="Edit, merge, split, reorder, rotate, and delete PDF files entirely in your browser. No uploads, no servers, no privacy compromises."
>
  <div class="page-wrapper" transition:animate={contentSlide}>
    <Nav currentPage="home" />
    <main>
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-left">
            <p class="hero-label">Client-side PDF editor</p>
            <h1 class="hero-title">Interleaf</h1>
            <div class="hero-tagline">
              <span class="red-bar"></span>
              <p class="hero-tagline-text">Edit, merge, split — all in your browser.</p>
            </div>
          </div>
          <div class="hero-right">
            <div class="hero-right-inner">
              <p class="hero-right-text">
                No file uploads. No server processing. Every operation runs entirely in your
                browser. Your documents stay private.
              </p>
              <a href={`${base}app`} class="cta-underline">Open Editor</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section py-16">
        <div class="features-header animate-on-scroll">
          <h2 class="features-title">Features</h2>
          <p class="features-subtitle">Five core operations, zero compromises.</p>
        </div>

        <div class="border-t-2 border-primary">
          {
            [
              {
                num: "01",
                title: "Merge",
                text: "Combine multiple PDF files into one cohesive document.",
                accent: false,
              },
              {
                num: "02",
                title: "Split",
                text: "Extract specific pages into separate PDF files.",
                accent: false,
              },
              {
                num: "03",
                title: "Reorder",
                text: "Drag and drop pages to arrange them in any order you need.",
                accent: false,
              },
              {
                num: "04",
                title: "Rotate",
                text: "Rotate any page to 90, 180, or 270 degrees.",
                accent: false,
              },
              {
                num: "05",
                title: "Delete",
                text: "Remove unwanted pages cleanly from any PDF.",
                accent: true,
              },
            ].map((f, i) => (
              <NumberedRow
                num={f.num}
                title={f.title}
                titleClass={f.accent ? "text-accent" : ""}
                isLast={f.accent}
                staggerClass={`stagger-${Math.min(i + 1, 8)}`}
              >
                <p>{f.text}</p>
              </NumberedRow>
            ))
          }
        </div>
      </section>

      <BottomCTA buttonText="Launch Interleaf" buttonHref={`${base}app`}>
        <Fragment slot="heading">Start<br />editing.</Fragment>
      </BottomCTA>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  /* Hero entrance animations */
  .hero-title {
    animation: var(--animate-slide-up);
    animation-delay: 0.2s;
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 10rem);
    line-height: 0.85;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  .hero-tagline {
    animation: var(--animate-slide-up);
    animation-delay: 0.3s;
  }

  .hero-right-inner {
    animation: var(--animate-fade-in);
    animation-delay: 0.4s;
  }

  /* Hero */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 4rem 1.5rem;
  }

  @media (min-width: 768px) {
    .hero {
      padding: 4rem 4rem;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding: 4rem 6rem;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 80rem;
    margin: 0 auto;
    width: 100%;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 2fr 1fr;
      gap: 2rem;
    }
  }

  .hero-label {
    animation: var(--animate-slide-up);
    animation-delay: 0.1s;
    font-size: 0.8rem;
    font-weight: var(--font-weight-light);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-section);
    margin-bottom: 1.5rem;
  }

  .hero-tagline {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .red-bar {
    display: block;
    width: 3rem;
    height: 4px;
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .hero-tagline-text {
    font-size: 1.05rem;
    font-weight: var(--font-weight-light);
    color: var(--color-muted);
  }

  .hero-right {
    display: flex;
    justify-content: flex-end;
  }

  .hero-right-inner {
    border-left: 4px solid var(--color-accent);
    padding-left: 1.5rem;
    max-width: 20rem;
  }

  .hero-right-text {
    font-size: 0.95rem;
    color: var(--color-body);
    line-height: 1.7;
  }

  .cta-underline {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    text-decoration: none;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 4px;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .cta-underline:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .cta-underline:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Features layout */
  .features-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .features-header {
      grid-template-columns: 1fr 2fr;
      align-items: end;
    }
  }

  .features-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    color: var(--color-primary);
  }

  .features-subtitle {
    font-weight: var(--font-weight-light);
    color: var(--color-muted);
  }
</style>
