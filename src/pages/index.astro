---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/shared/Nav.astro";
import Footer from "../components/shared/Footer.astro";
import NumberedRow from "../components/shared/NumberedRow.astro";
import BottomCTA from "../components/shared/BottomCTA.astro";
import { contentSlide } from "../utils/transitions";

const base = import.meta.env.BASE_URL;

const operations = [
  {
    num: "01",
    title: "Merge",
    text: "Combine multiple PDF files into one document.",
  },
  {
    num: "02",
    title: "Extract",
    text: "Pull selected pages into a new PDF.",
  },
  {
    num: "03",
    title: "Reorder",
    text: "Arrange pages with drag and drop.",
  },
  {
    num: "04",
    title: "Rotate",
    text: "Turn individual pages or a selection in 90-degree steps.",
  },
  {
    num: "05",
    title: "Delete",
    text: "Mark unwanted pages for removal before export.",
  },
  {
    num: "06",
    title: "Unlock",
    text: "Open password-protected PDFs with an in-browser prompt.",
  },
];
---

<Layout
  title="Interleaf - Client-Side PDF Editor"
  description="Edit, merge, extract, reorder, rotate, delete, and unlock PDF files entirely in your browser. No uploads, no servers, no privacy compromises."
>
  <div class="page-wrapper" transition:animate={contentSlide}>
    <Nav currentPage="home" />

    <main id="main-content">
      <section class="hero">
        <div class="hero-grid">
          <div class="hero-main">
            <p class="hero-label eyebrow animate-on-scroll">Private PDF editor</p>
            <h1 class="hero-title">Interleaf</h1>
            <p class="hero-tagline">
              Work with the pages.<br />Keep the files with you.
            </p>
            <div class="hero-actions">
              <a href={`${base}app`} class="btn-primary text-xs no-underline press-feedback">
                Open Editor
              </a>
              <p class="hero-action-note">Six core operations. One browser tab.</p>
            </div>
          </div>

          <aside class="hero-proof animate-on-scroll" aria-label="Interleaf privacy promise">
            <p class="hero-proof-index">01</p>
            <div>
              <p class="hero-proof-label eyebrow">Privacy is the default</p>
              <p class="hero-proof-text">
                Your documents are processed in your browser. Nothing is uploaded. Nothing is sent
                to a server.
              </p>
            </div>
          </aside>
        </div>
      </section>

      <section class="section section-space">
        <div class="section-intro animate-on-scroll">
          <p class="eyebrow">What you can do</p>
          <div>
            <h2 class="section-title text-balance">A workbench for the pages that matter.</h2>
            <p class="body-text mt-5 max-w-2xl">
              Open a PDF, make the changes you need, and export the result. Interleaf keeps the
              process close to the document and clear about where your files go.
            </p>
          </div>
        </div>

        <div class="border-t-2 border-primary">
          {
            operations.map((operation, i) => (
              <NumberedRow
                num={operation.num}
                title={operation.title}
                titleClass={i === operations.length - 1 ? "text-accent" : ""}
                isLast={i === operations.length - 1}
                staggerClass={`stagger-${Math.min(i + 1, 8)}`}
              >
                <p>{operation.text}</p>
              </NumberedRow>
            ))
          }
        </div>
      </section>

      <section class="section landing-proof-section">
        <div class="landing-proof-grid">
          <div class="surface-note animate-on-scroll">
            <p class="eyebrow mb-4">No upload step</p>
            <p class="body-text text-lg">
              Interleaf works with the file already on your device. Your PDF stays in the browser
              while you edit it.
            </p>
          </div>
          <div class="landing-proof-copy animate-on-scroll stagger-1">
            <p class="eyebrow mb-4">A clear starting point</p>
            <p class="body-text">
              There is no account to create and no workspace to configure. Open the editor when you
              have a document to fix.
            </p>
          </div>
        </div>
      </section>

      <BottomCTA buttonText="Open Editor" buttonHref={`${base}app`}>
        <Fragment slot="heading">Start<br />editing.</Fragment>
      </BottomCTA>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .hero {
    min-height: clamp(34rem, calc(100svh - 4rem), 48rem);
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--color-primary);
    padding: clamp(4rem, 9vw, 7rem) 1.25rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 0.7fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: end;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
  }

  .hero-main {
    min-width: 0;
  }

  .hero-label {
    animation: var(--animate-slide-up);
    animation-delay: 0.1s;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    animation: var(--animate-slide-up);
    animation-delay: 0.2s;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: clamp(5rem, 16vw, 12rem);
    letter-spacing: -0.015em;
    line-height: 0.78;
    text-wrap: balance;
  }

  .hero-tagline {
    animation: var(--animate-slide-up);
    animation-delay: 0.3s;
    max-width: 28rem;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    border-left: 4px solid var(--color-accent);
    padding-left: 1.25rem;
    color: var(--color-body);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: var(--font-weight-light);
    line-height: 1.35;
  }

  .hero-actions {
    animation: var(--animate-fade-in);
    animation-delay: 0.45s;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 2.5rem;
  }

  .hero-action-note {
    max-width: 12rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .hero-proof {
    animation: var(--animate-fade-in);
    animation-delay: 0.5s;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    border-left: 4px solid var(--color-accent);
    padding: 0 0 0 1.5rem;
  }

  .hero-proof-index {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }

  .hero-proof-label {
    margin-bottom: 1rem;
  }

  .hero-proof-text {
    margin: 0;
    color: var(--color-body);
    font-size: 0.95rem;
    font-weight: var(--font-weight-light);
    line-height: 1.7;
  }

  .landing-proof-section {
    padding-top: 0;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .landing-proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(15rem, 0.7fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: start;
    border-top: 1px solid var(--color-border);
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  .landing-proof-copy {
    max-width: 24rem;
    padding-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero {
      padding-right: 3rem;
      padding-left: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-right: 5rem;
      padding-left: 5rem;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding-top: 5rem;
      padding-bottom: 5rem;
    }

    .hero-grid,
    .landing-proof-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      gap: 4rem;
    }

    .hero-proof {
      border-top: 1px solid var(--color-border);
      border-left: 0;
      padding: 1.5rem 0 0;
    }

    .landing-proof-copy {
      padding-top: 0;
    }
  }
</style>
