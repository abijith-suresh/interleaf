---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/shared/Nav.astro";
import Footer from "../components/shared/Footer.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Interleaf - Put the document right"
  description="Fix the pages in a PDF in your browser. Your file stays on your device."
>
  <div class="landing-page">
    <Nav currentPage="home" />

    <main id="main-content">
      <section class="landing-hero" aria-labelledby="landing-title">
        <div class="landing-hero-inner">
          <div class="landing-copy">
            <h1 id="landing-title">Put the<br /><span>document right.</span></h1>
            <p class="landing-intro">
              When a PDF is almost right, fix its pages in your browser and take the file with you.
            </p>
            <div class="landing-action">
              <a href={`${base}app`} class="btn-primary landing-cta press-feedback">Open editor</a>
              <p>Your file stays on your device.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="landing-note" aria-label="How Interleaf works">
        <p>Open a document. Make the pages fit. Export it when it is ready.</p>
        <a href={`${base}about`}>Why Interleaf <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .landing-page {
    min-height: 100vh;
    background: var(--color-white);
    color: var(--color-primary);
    font-family: var(--font-body);
  }

  .landing-hero {
    display: grid;
    min-height: min(44rem, calc(100svh - 4rem));
    align-items: center;
    border-bottom: 1px solid var(--color-primary);
    padding: clamp(4rem, 9vw, 7rem) 1.25rem;
  }

  .landing-hero-inner {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
  }

  .landing-copy {
    max-width: 55rem;
  }

  .landing-copy h1 {
    margin: 0;
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 13vw, 10rem);
    letter-spacing: -0.015em;
    line-height: 0.8;
    text-wrap: balance;
  }

  .landing-copy h1 span {
    color: var(--color-accent);
  }

  .landing-intro {
    max-width: 34rem;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    color: var(--color-body);
    font-size: clamp(1.15rem, 2.1vw, 1.5rem);
    font-weight: var(--font-weight-light);
    line-height: 1.45;
  }

  .landing-action {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 2.5rem;
  }

  .landing-cta {
    text-transform: uppercase;
  }

  .landing-action p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .landing-note {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 2.5rem), 72rem);
    margin-inline: auto;
    padding: 1.5rem 0;
  }

  .landing-note p,
  .landing-note a {
    margin: 0;
    color: var(--color-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-light);
    line-height: 1.5;
  }

  .landing-note a {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: none;
  }

  .landing-note a span {
    color: var(--color-accent);
    font-size: 1rem;
  }

  .landing-note a:hover {
    color: var(--color-accent);
  }

  .landing-note a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (min-width: 768px) {
    .landing-hero {
      padding-right: 3rem;
      padding-left: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .landing-hero {
      padding-right: 5rem;
      padding-left: 5rem;
    }
  }

  @media (max-width: 520px) {
    .landing-hero {
      min-height: calc(100svh - 4rem);
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .landing-copy h1 {
      font-size: clamp(4rem, 19vw, 6rem);
    }

    .landing-action {
      align-items: flex-start;
      flex-direction: column;
    }

    .landing-note {
      align-items: flex-start;
      flex-direction: column;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }
  }
</style>
