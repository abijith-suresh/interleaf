---
import MarketingLayout from "../components/marketing/MarketingLayout.astro";

const questions = [
  {
    q: "How does client-side processing work?",
    a: "Interleaf uses JavaScript libraries that run entirely in your browser. When you choose a PDF, the browser reads it into memory and processes it locally. No data is sent to a server.",
  },
  {
    q: "Is my data private?",
    a: "Yes. Your files never leave your device. There are no uploads, server-side processing, or data collection. You can verify this in your browser's developer tools by inspecting the network tab.",
  },
  {
    q: "Which browsers are supported?",
    a: "Interleaf works in modern Chrome, Firefox, Safari, and Edge browsers. Use the latest version for the best experience.",
  },
  {
    q: "Is there a file size limit?",
    a: "There is no hard file size limit. Very large files, such as files over 100 MB, may be slower depending on your device's available memory and processing power.",
  },
  {
    q: "Is Interleaf free to use?",
    a: "Yes. Interleaf is free and open source. There are no premium tiers, subscriptions, or hidden costs.",
  },
  {
    q: "Can I contribute to the project?",
    a: "Yes. Interleaf is open source and hosted on GitHub. You can report issues, suggest features, or submit pull requests.",
  },
  {
    q: "Does Interleaf work offline?",
    a: "Once the page is loaded, most operations work without an internet connection. You need to be online to load the application initially.",
  },
  {
    q: "What PDF operations are supported?",
    a: "Interleaf currently supports merging, extracting selected pages, reordering, rotating, marking pages for deletion, unlocking password-protected PDFs, and losslessly compressing an untouched, single uploaded PDF. All operations run in your browser.",
  },
];
---

<MarketingLayout
  title="FAQ — Interleaf"
  description="Short answers about using Interleaf in your browser, including privacy, browser support, file sizes, and offline use."
  currentPage="faq"
>
  <section class="page-intro" aria-labelledby="faq-title">
    <div class="marketing-container">
      <div class="page-intro-copy">
        <h1 id="faq-title">Questions, answered.</h1>
        <p>Short answers about using Interleaf in your browser.</p>
      </div>
    </div>
  </section>

  <section class="faq-content" aria-label="Frequently asked questions">
    <div class="marketing-container">
      <div class="faq-list">
        {
          questions.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.q}</span>
                <span class="summary-mark" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  a,
  summary {
    -webkit-tap-highlight-color: rgb(255 42 31 / 18%);
    touch-action: manipulation;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--marketing-accent);
    outline-offset: 4px;
  }

  .page-intro {
    border-bottom: 1px solid var(--marketing-rule);
    padding-block: clamp(4.5rem, 10vw, 7.5rem) clamp(3rem, 6vw, 5rem);
  }

  .page-intro-copy {
    max-width: 48rem;
  }

  h1 {
    margin: 0;
    color: var(--marketing-ink);
    font-size: clamp(3.25rem, 8vw, 6.25rem);
    font-weight: 500;
    letter-spacing: -0.09em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .page-intro p {
    max-width: 30rem;
    margin: 1.75rem 0 0;
    color: var(--marketing-muted);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.55;
  }

  .faq-content {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(5rem, 10vw, 8rem);
  }

  .faq-list {
    max-width: 54rem;
    margin-inline: auto;
    border-top: 1px solid var(--marketing-rule-strong);
    background: var(--marketing-paper);
  }

  details {
    border-bottom: 1px solid var(--marketing-rule);
  }

  details[open] {
    background: #fffefa;
  }

  summary {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    color: var(--marketing-ink);
    cursor: pointer;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    font-weight: 500;
    line-height: 1.35;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--marketing-accent);
  }

  .summary-mark {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--marketing-rule-strong);
    border-radius: 50%;
    color: var(--marketing-muted);
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1;
  }

  details[open] .summary-mark {
    background: var(--marketing-accent);
    border-color: var(--marketing-accent);
    color: #fff;
    transform: rotate(45deg);
  }

  .faq-answer {
    max-width: 43rem;
    padding: 0 4.5rem 1.5rem 1.5rem;
  }

  .faq-answer p {
    margin: 0;
    color: var(--marketing-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  @media (max-width: 520px) {
    .page-intro {
      padding-top: 4rem;
    }

    summary {
      min-height: 4rem;
      padding: 1.1rem 1rem;
    }

    .faq-answer {
      padding-right: 1rem;
      padding-left: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
      scroll-behavior: auto;
      transition-duration: 0.01ms;
    }
  }
</style>
