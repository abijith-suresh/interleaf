---
import MarketingHero from "../components/marketing/MarketingHero.astro";
import MarketingLayout from "../components/marketing/MarketingLayout.astro";
import MarketingSplit from "../components/marketing/MarketingSplit.astro";

const questions = [
  {
    q: "Are my files uploaded?",
    a: "No. Interleaf works on your files in your browser and never sends them anywhere. You can confirm this in your browser's network inspector.",
  },
  {
    q: "Is there a file size limit?",
    a: "Interleaf sets none, but very large files can be slow or fail, depending on your device's memory. One PNG export is capped at 128 MiB.",
  },
  {
    q: "Does Interleaf work offline?",
    a: "No. The editor loads code from this site as you work, so stay online until you finish.",
  },
  {
    q: "Which browsers are supported?",
    a: "Current versions of Chromium-based browsers, Firefox, and Safari.",
  },
  {
    q: "Which form fields can I fill?",
    a: "Most single-line text fields in unencrypted PDFs. For checkboxes and scanned forms, add checkmarks instead.",
  },
  {
    q: "Can I type accented letters?",
    a: "No. Added text and form answers accept the letters, numbers, and symbols on a US keyboard.",
  },
  {
    q: "Is Interleaf free?",
    a: "Yes. Interleaf is free and open source, with no paid plans.",
  },
  {
    q: "How can I contribute?",
    a: "Report issues or open pull requests on GitHub.",
  },
];

const groups = [
  { id: "privacy-and-files", title: "Privacy and files", questions: [0, 1, 2] },
  { id: "using-interleaf", title: "Using Interleaf", questions: [3, 4, 5] },
  { id: "the-project", title: "The project", questions: [6, 7] },
];
---

<MarketingLayout
  title="FAQ | Interleaf"
  description="Short answers about privacy, file size, browser support, and form filling in Interleaf."
  currentPage="faq"
>
  <MarketingHero
    titleId="faq-title"
    title="Questions, answered."
    lede="Short answers about Interleaf."
  />

  <section class="marketing-section" aria-label="Frequently asked questions">
    <MarketingSplit asideOnMobile={false}>
      <div slot="aside">
        <nav aria-label="FAQ sections">
          {
            groups.map((group) => (
              <a class="marketing-link" href={`#${group.id}`}>{group.title}</a>
            ))
          }
        </nav>
        <div class="faq-contact">
          <p>Still have a question?</p>
          <a
            href="https://github.com/abijith-suresh/interleaf/issues"
            target="_blank"
            rel="noopener noreferrer"
          >Ask on GitHub</a>
        </div>
      </div>
      <div class="faq-groups">
        {
          groups.map((group) => (
            <section id={group.id} aria-labelledby={`${group.id}-title`} class="faq-group">
              <h2 id={`${group.id}-title`}>{group.title}</h2>
              <div class="faq-list">
                {group.questions.map((questionIndex) => (
                  <details class="faq-item" open={questionIndex === 0}>
                    <summary>
                      <span class="faq-question">{questions[questionIndex].q}</span>
                      <svg class="faq-chevron" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          d="m6 9 6 6 6-6"
                          fill="none"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                        />
                      </svg>
                    </summary>
                    <div class="faq-answer">
                      <p>{questions[questionIndex].a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
        <div class="faq-contact faq-contact-mobile">
          <p>Still have a question?</p>
          <a
            href="https://github.com/abijith-suresh/interleaf/issues"
            target="_blank"
            rel="noopener noreferrer"
          >Ask on GitHub</a>
        </div>
      </div>
    </MarketingSplit>
  </section>
</MarketingLayout>

<style>
  @reference "../styles/global.css";

  .faq-groups {
    display: grid;
    gap: 2rem;
    min-width: 0;
  }

  .faq-group {
    scroll-margin-top: 1.5rem;
  }

  .faq-group h2 {
    @apply text-ui-xs;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
    margin: 0 0 0.75rem;
  }

  nav {
    margin-bottom: 1.5rem;
  }

  nav .marketing-link {
    width: 100%;
    justify-content: flex-start;
    text-align: left;
    transition: none;
  }

  .faq-contact {
    padding: 1rem;
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    color: var(--color-fg);
    @apply text-ui-sm;
  }

  .faq-contact p {
    margin: 0 0 0.5rem;
  }

  .faq-contact a {
    color: var(--color-fg);
    text-decoration-line: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 4px;
  }

  .faq-contact a:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 64rem) {
    .faq-contact-mobile {
      display: none;
    }
  }

  /* Cards' accordion inside one card: a line between items, a chevron that
     turns over while open. */
  .faq-list {
    padding-inline: 1.5rem;
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  .faq-item + .faq-item {
    border-top: 1px solid var(--color-line);
  }

  /* Smooth expand/collapse: ::details-content is a grid whose row interpolates
     0fr -> 1fr. Supported in Chrome/Edge 131+, Safari 18.4+, and Firefox 143+;
     older browsers fall back to an instant, jank-free toggle. The closed state
     owns content-visibility: hidden and defers it via a 0s discrete transition
     delayed to the end of the collapse, so the browser cannot skip (and
     size-contain) the content mid-collapse; the open state reveals immediately. */
  .faq-item::details-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    content-visibility: hidden;
    transition:
      grid-template-rows 160ms ease-out,
      opacity 160ms ease-out,
      content-visibility 0s allow-discrete 160ms;
  }

  .faq-item[open]::details-content {
    grid-template-rows: 1fr;
    opacity: 1;
    content-visibility: visible;
    transition:
      grid-template-rows 200ms var(--ease-out-expo),
      opacity 200ms var(--ease-out-expo),
      content-visibility 0s allow-discrete;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-inline: -0.5rem;
    padding: 1rem 0.5rem;
    border-radius: var(--radius-md);
    color: var(--color-fg);
    cursor: pointer;
    list-style: none;
    -webkit-user-select: none;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    min-width: 0;
    text-wrap: balance;
    @apply text-ui-md;
  }

  .faq-chevron {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    color: var(--color-fg-subtle);
    transition:
      color 150ms var(--ease-tactile),
      rotate 200ms var(--ease-tactile);
  }

  summary:hover .faq-chevron {
    color: var(--color-fg-muted);
  }

  .faq-item[open] .faq-chevron {
    rotate: 180deg;
  }

  .faq-answer {
    min-height: 0;
    overflow: clip;
  }

  .faq-answer p {
    max-width: 43rem;
    margin: 0;
    padding-bottom: 1.25rem;
    color: var(--color-fg-muted);
    text-wrap: pretty;
    @apply text-body-sm;
  }

  @media (max-width: 47.99rem) {
    .faq-list {
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content,
    .faq-item[open]::details-content,
    .faq-chevron {
      transition-duration: 0.01ms;
      transition-delay: 0s;
    }
  }
</style>
