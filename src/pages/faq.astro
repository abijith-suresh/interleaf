---
import MarketingLayout from "../components/marketing/MarketingLayout.astro";
import MarketingHero from "../components/marketing/MarketingHero.astro";

const questions = [
  {
    q: "How does client-side processing work?",
    a: "Interleaf uses JavaScript libraries that run entirely in your browser. When you choose a PDF or image, the browser reads it into memory and processes it locally. No data is sent to a server.",
  },
  {
    q: "Is my data private?",
    a: "Yes. Your files never leave your device. There are no uploads, server-side processing, or data collection. You can verify this in your browser's network inspector.",
  },
  {
    q: "Which browsers are supported?",
    a: "Interleaf works in modern Chrome, Firefox, Safari, and Edge browsers. Use the latest version for the best experience.",
  },
  {
    q: "Is there a file size limit?",
    a: "There is no fixed file size limit. Operations run in your browser's available memory, so very large files can be slower or fail, depending on your device.",
  },
  {
    q: "Is Interleaf free to use?",
    a: "Yes. Interleaf is free and open source. There are no premium tiers, subscriptions, or hidden costs.",
  },
  {
    q: "Can I contribute to the project?",
    a: "Yes. Interleaf is open source and hosted on GitHub. You can report issues, suggest features, or submit pull requests.",
  },
  {
    q: "Does Interleaf work offline?",
    a: "After the page loads, most operations work without an internet connection. Loading the editor needs a connection the first time.",
  },
  {
    q: "What PDF operations are supported?",
    a: "Interleaf opens PDFs and PNG or JPEG images together, converts images to PDF pages, reviews pages one at a time, reorders and rotates pages, marks pages for deletion, extracts selected pages into a new PDF, exports pages as PNG images, unlocks password-protected PDFs, and compresses one untouched PDF. All operations run in your browser.",
  },
];
---

<MarketingLayout
  title="FAQ — Interleaf"
  description="Short answers about using Interleaf in your browser, including privacy, browser support, file sizes, and offline use."
  currentPage="faq"
>
  <MarketingHero titleId="faq-title">
    <h1 slot="primary" id="faq-title" class="marketing-hero-title">Questions, answered.</h1>
    <div slot="secondary" class="faq-hero-copy">
      <p>Short answers about using Interleaf in your browser.</p>
    </div>
  </MarketingHero>

  <section class="faq-content" aria-label="Frequently asked questions">
    <div class="marketing-container">
      <div class="faq-list">
        {
          questions.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.q}</span>
                <span class="summary-mark" aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  a,
  summary {
    -webkit-tap-highlight-color: rgb(255 42 31 / 18%);
    touch-action: manipulation;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--marketing-accent);
    outline-offset: 4px;
  }

  .faq-hero-copy {
    max-width: 26rem;
  }

  .faq-hero-copy p {
    margin: 0;
    color: var(--marketing-muted);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .faq-content {
    padding-block: clamp(3.75rem, 8vw, 6.5rem);
  }

  .faq-list {
    max-width: 72rem;
    margin-inline: auto;
    border-top: 1px solid var(--marketing-ink);
  }

  details {
    border-bottom: 1px solid var(--marketing-rule);
  }

  /* Unsupported browsers keep the native instant disclosure behavior. */
  @supports selector(details::details-content) {
    .faq-list details::details-content {
      display: grid;
      grid-template-rows: 0fr;
      overflow: clip;
      content-visibility: hidden;
      transition:
        grid-template-rows var(--marketing-disclosure-duration) var(--marketing-disclosure-ease),
        content-visibility 0s allow-discrete var(--marketing-disclosure-duration);
    }

    .faq-list details[open]::details-content {
      grid-template-rows: 1fr;
      content-visibility: visible;
      transition:
        grid-template-rows var(--marketing-disclosure-duration) var(--marketing-disclosure-ease),
        content-visibility 0s allow-discrete;
    }
  }

  summary {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.6rem 0;
    color: var(--marketing-ink);
    cursor: pointer;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    font-weight: 500;
    line-height: 1.35;
    list-style: none;
    -webkit-user-select: none;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--marketing-accent);
  }

  .summary-mark {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--marketing-rule-strong);
    border-radius: 50%;
    color: var(--marketing-muted);
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1;
  }

  @supports selector(details::details-content) {
    .summary-mark {
      transition:
        transform var(--marketing-disclosure-duration) var(--marketing-disclosure-ease),
        background-color var(--marketing-disclosure-duration) var(--marketing-disclosure-ease),
        border-color var(--marketing-disclosure-duration) var(--marketing-disclosure-ease),
        color var(--marketing-disclosure-duration) var(--marketing-disclosure-ease);
    }
  }

  details[open] .summary-mark {
    background: var(--marketing-accent);
    border-color: var(--marketing-accent);
    color: #fff;
    transform: rotate(45deg);
  }

  .faq-answer {
    max-width: 43rem;
    min-height: 0;
    overflow: clip;
    padding: 0;
  }

  .faq-answer p {
    margin: 0;
    padding-bottom: 1.6rem;
    color: var(--marketing-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
      scroll-behavior: auto;
      transition-duration: 0.01ms;
    }

    @supports selector(details::details-content) {
      .faq-list details::details-content,
      .faq-list details[open]::details-content,
      .faq-list .summary-mark {
        transition-duration: 0s;
        transition-delay: 0s;
      }
    }
  }
</style>
