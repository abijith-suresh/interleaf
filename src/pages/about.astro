---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/shared/Nav.astro";
import Footer from "../components/shared/Footer.astro";
import PageHeader from "../components/shared/PageHeader.astro";
import BottomCTA from "../components/shared/BottomCTA.astro";
import { contentSlide } from "../utils/transitions";

const stack = [
  { name: "Astro", desc: "Static site framework" },
  { name: "pdf-lib", desc: "PDF manipulation" },
  { name: "pdf.js", desc: "PDF rendering" },
  { name: "Tailwind CSS", desc: "Utility-first styling" },
  { name: "TypeScript", desc: "Type safety" },
  { name: "Bun", desc: "Package manager & runtime" },
];

const values = [
  { title: "Privacy", desc: "Your files never leave your browser. Zero data collection." },
  { title: "Simplicity", desc: "Clean interface, no bloat. Just the tools you need." },
  { title: "Open Source", desc: "Fully transparent. Inspect, modify, and contribute." },
  { title: "Speed", desc: "Client-side processing means instant results, no waiting for servers." },
];
---

<Layout
  title="About — Interleaf"
  description="Interleaf was built on one idea: every PDF operation should run in your browser. No accounts, no uploads, no servers. Open source and fully transparent."
>
  <div class="page-wrapper" transition:animate={contentSlide}>
    <Nav currentPage="about" />

    <main id="main-content">
      <PageHeader label="Company">
        <Fragment slot="title">Why Interleaf.</Fragment>
      </PageHeader>

      <section class="section section-space">
        <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-12 animate-on-scroll">
          <div>
            <p class="body-text content-measure text-lg mb-6">
              PDF tools shouldn't require uploading your documents to someone else's server.
              Interleaf was built on a simple idea: every PDF operation can happen right in your
              browser.
            </p>
            <p class="body-text">
              No accounts. No subscriptions. No file size limits imposed by a server. Just open the
              editor, drop your files in, and get to work. Everything runs client-side using modern
              browser APIs and WebAssembly-powered libraries.
            </p>
          </div>
          <div class="surface-note self-start">
            <p class="text-sm text-body font-light leading-relaxed">
              Built as an open-source project to demonstrate that powerful tools don't need to
              compromise on privacy.
            </p>
          </div>
        </div>
      </section>

      <section class="section section-space border-t border-border">
        <div>
          <div class="section-intro mb-10 animate-on-scroll">
            <p class="eyebrow">How it is made</p>
            <h2 class="section-title text-balance">Small, open, and close to the browser.</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 border-t-2 border-primary">
            {
              stack.map((s, i) => (
                <div
                  class:list={[
                    "border-b border-border py-5 pr-4 animate-on-scroll",
                    `stagger-${Math.min(i + 1, 8)}`,
                  ]}
                >
                  <p class="font-display text-xl text-primary">{s.name}</p>
                  <p class="text-xs text-muted font-light mt-1">{s.desc}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section section-space border-t border-border">
        <div>
          <h2 class="section-heading mb-8 animate-on-scroll">Values</h2>
          <div class="border-t-2 border-primary">
            {
              values.map((v, i) => (
                <div
                  class:list={[
                    "grid grid-cols-1 md:grid-cols-[10rem_1fr] gap-2 md:gap-8 py-6 border-b animate-on-scroll",
                    i === values.length - 1 ? "border-primary border-b-2" : "border-border",
                    `stagger-${Math.min(i + 1, 8)}`,
                  ]}
                >
                  <h3 class="font-display text-xl text-primary">{v.title}</h3>
                  <p class="body-text">{v.desc}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <BottomCTA
        buttonText="View on GitHub"
        buttonHref="https://github.com/abijith-suresh/interleaf"
      >
        <Fragment slot="heading">Open source.</Fragment>
      </BottomCTA>
    </main>

    <Footer />
  </div>
</Layout>
