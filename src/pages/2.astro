---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const experiments = ["1", "2", "3", "4", "5"];
---

<Layout
  title="Interleaf / Calm utility"
  description="Fix the pages in a PDF locally in your browser."
>
  <div class="calm-page">
    <header class="site-header">
      <a class="brand" href={base} aria-label="Interleaf home">interleaf</a>

      <div class="header-links">
        <a class="home-link" href={base}>Home</a>
        <nav class="study-switcher" aria-label="Landing page design experiments">
          {
            experiments.map((experiment) => (
              <a
                href={`${base}${experiment}`}
                class:list={["study-link", experiment === "2" && "is-current"]}
                aria-current={experiment === "2" ? "page" : undefined}
              >
                /{experiment}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="workspace">
          <div class="workspace-bar" aria-hidden="true">
            <span class="bar-dot"></span>
            <span class="bar-rule"></span>
            <span class="bar-rule bar-rule-short"></span>
          </div>

          <div class="workspace-body">
            <div class="hero-copy">
              <h1 id="hero-title">
                Fix the PDF<br />
                <span>you <em>already</em> have.</span>
              </h1>
              <p>
                When a PDF is almost right, Interleaf lets you fix its pages locally in the browser.
              </p>
              <a class="primary-action" href={`${base}app`}>
                Open editor <span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="workspace-canvas" aria-hidden="true">
              <span class="canvas-corner canvas-corner-top"></span>
              <span class="canvas-corner canvas-corner-bottom"></span>
              <span class="canvas-axis canvas-axis-horizontal"></span>
              <span class="canvas-axis canvas-axis-vertical"></span>
              <span class="canvas-point"></span>
            </div>
          </div>

          <div class="workspace-footer">
            <span class="footer-mark" aria-hidden="true"></span>
            <p>Your PDF stays in your browser.</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Interleaf</span>
      <span>Calm utility / 02</span>
    </footer>
  </div>
</Layout>

<style>
  :global(html),
  :global(body) {
    background: #f7f5f0;
  }

  .calm-page {
    --ink: #242421;
    --muted: #77756e;
    --structure: #dedbd4;
    --structure-soft: #eae7e0;
    --paper: #fcfbf8;
    --warm-white: #f7f5f0;
    --accent: #ff2a1f;
    min-height: 100svh;
    background: var(--warm-white);
    color: var(--ink);
    font-family: var(--font-body);
  }

  .site-header,
  .site-footer,
  .hero {
    width: min(calc(100% - 2rem), 72rem);
    margin-inline: auto;
  }

  .site-header {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-bottom: 1px solid var(--structure);
  }

  .brand,
  .home-link,
  .study-link,
  .primary-action {
    color: inherit;
    text-decoration: none;
  }

  .brand {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.055em;
  }

  .header-links,
  .study-switcher {
    display: flex;
    align-items: center;
  }

  .header-links {
    gap: 1.25rem;
  }

  .home-link,
  .study-link {
    min-height: 2.75rem;
    align-content: center;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1;
  }

  .home-link {
    color: var(--ink);
  }

  .study-switcher {
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--structure);
    border-radius: 999px;
    background: var(--paper);
  }

  .study-link {
    display: inline-grid;
    min-width: 2rem;
    min-height: 2rem;
    place-items: center;
    border-radius: 999px;
  }

  .study-link:hover {
    color: var(--ink);
    background: var(--structure-soft);
  }

  .study-link.is-current {
    background: var(--ink);
    color: var(--paper);
  }

  .calm-page a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .hero {
    display: grid;
    min-height: calc(100svh - 9.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vh, 7rem);
  }

  .workspace {
    overflow: hidden;
    border: 1px solid var(--structure);
    border-radius: 1.25rem;
    background: var(--paper);
    box-shadow: 0 1.5rem 4rem rgb(48 45 39 / 7%);
  }

  .workspace-bar {
    display: flex;
    height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 1.25rem;
    border-bottom: 1px solid var(--structure-soft);
  }

  .bar-dot,
  .footer-mark {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--accent);
  }

  .bar-rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--structure);
  }

  .bar-rule-short {
    width: 1rem;
  }

  .workspace-body {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(15rem, 0.92fr);
    min-height: min(34rem, 58vh);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    padding: clamp(2.5rem, 7vw, 6.5rem);
  }

  .hero-copy {
    max-width: 37rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.4rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.085em;
    line-height: 0.93;
  }

  h1 em {
    font-style: normal;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  .hero-copy p {
    max-width: 31rem;
    margin: clamp(1.75rem, 4vw, 2.75rem) 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.52;
  }

  .primary-action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2rem;
    padding: 0.8rem 1.1rem 0.8rem 1.25rem;
    border-radius: 0.55rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .primary-action span {
    font-size: 1.15rem;
    line-height: 1;
  }

  .primary-action:hover {
    background: var(--ink);
    transform: translateY(-1px);
  }

  .primary-action:active {
    transform: translateY(0);
  }

  .workspace-canvas {
    position: relative;
    width: min(100%, 22rem);
    aspect-ratio: 1.05;
    justify-self: end;
    border: 1px solid var(--structure);
    border-radius: 0.8rem;
    background:
      linear-gradient(var(--structure-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--structure-soft) 1px, transparent 1px),
      #f7f5f0;
    background-position: center;
    background-size: 25% 25%;
  }

  .canvas-corner {
    position: absolute;
    width: 2.25rem;
    height: 2.25rem;
    border-color: var(--ink);
  }

  .canvas-corner-top {
    top: 16%;
    left: 16%;
    border-top: 1px solid;
    border-left: 1px solid;
  }

  .canvas-corner-bottom {
    right: 16%;
    bottom: 16%;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }

  .canvas-axis {
    position: absolute;
    background: var(--structure);
  }

  .canvas-axis-horizontal {
    top: 50%;
    right: 16%;
    left: 16%;
    height: 1px;
  }

  .canvas-axis-vertical {
    top: 16%;
    bottom: 16%;
    left: 50%;
    width: 1px;
  }

  .canvas-point {
    position: absolute;
    top: calc(50% - 0.35rem);
    left: calc(50% - 0.35rem);
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.45rem rgb(255 42 31 / 12%);
  }

  .workspace-footer {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3.5rem;
    padding-inline: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--structure-soft);
  }

  .workspace-footer p {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    padding-block: 1.5rem 2rem;
    color: var(--muted);
    font-size: 0.7rem;
  }

  .site-footer span:first-child {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .site-header {
      min-height: 4.25rem;
    }

    .header-links {
      gap: 0.5rem;
    }

    .home-link {
      padding-inline: 0.45rem;
    }

    .hero {
      min-height: auto;
      padding-block: 2.5rem 3.5rem;
    }

    .workspace-body {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2.75rem;
      padding: 2.5rem 1.5rem 3rem;
    }

    h1 {
      font-size: clamp(3.15rem, 14vw, 5.2rem);
    }

    .workspace-canvas {
      width: min(100%, 20rem);
      justify-self: center;
    }

    .site-footer {
      padding-bottom: 1.25rem;
    }
  }

  @media (max-width: 24rem) {
    .brand {
      font-size: 0.95rem;
    }

    .home-link {
      display: none;
    }

    .study-link {
      min-width: 1.8rem;
    }

    .workspace-body {
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .calm-page *,
    .calm-page *::before,
    .calm-page *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
