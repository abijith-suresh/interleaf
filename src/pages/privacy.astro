---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/shared/Nav.astro";
import Footer from "../components/shared/Footer.astro";
import { contentSlide } from "../utils/transitions";

const sections = [
  {
    num: "01",
    title: "No Data Collection",
    content:
      "Interleaf does not collect, store, or transmit any personal data. We do not use analytics, tracking pixels, or any form of user monitoring.",
  },
  {
    num: "02",
    title: "Client-Side Processing",
    content:
      "All PDF operations run entirely in your browser using JavaScript. Your files are never uploaded to any server. Documents are processed in memory and discarded when you close the tab.",
  },
  {
    num: "03",
    title: "No Cookies",
    content:
      "Interleaf does not use cookies, local storage, or any other client-side storage mechanism to track users or store personal information.",
  },
  {
    num: "04",
    title: "No Third-Party Services",
    content:
      "We do not integrate with any third-party analytics, advertising, or tracking services. The only external resources loaded are Google Fonts for typography.",
  },
  {
    num: "05",
    title: "Open Source",
    content:
      "Interleaf is fully open source. You can inspect the complete source code on GitHub to verify these privacy claims for yourself.",
  },
  {
    num: "06",
    title: "Contact",
    content:
      "If you have questions about this privacy policy, you can open an issue on our GitHub repository.",
  },
];
---

<Layout
  title="Privacy Policy — Interleaf"
  description="Interleaf collects no data, uses no cookies, and never uploads your files. Your documents stay in your browser. Always."
>
  <div class="font-body bg-white text-primary min-h-screen" transition:animate={contentSlide}>
    <Nav />

    <main>
      <section class="px-6 md:px-16 lg:px-24 pt-24 pb-16 border-b border-border">
        <div class="max-w-7xl mx-auto">
          <p class="section-heading animate-on-scroll">Legal</p>
          <h1 class="page-heading animate-on-scroll stagger-1">
            Privacy<br />Policy.
          </h1>
        </div>
      </section>

      <section class="px-6 md:px-16 lg:px-24 py-16">
        <div class="max-w-7xl mx-auto border-t-2 border-primary">
          {
            sections.map((s, i) => (
              <div
                class:list={[
                  "numbered-row animate-on-scroll",
                  i === sections.length - 1 && "numbered-row-last",
                  `stagger-${Math.min(i + 1, 8)}`,
                ]}
              >
                <span class="numbered-row-num">{s.num}</span>
                <h2 class="numbered-row-title">{s.title}</h2>
                <p class="numbered-row-desc">{s.content}</p>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
