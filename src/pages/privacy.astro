---
import LegalPage from "../components/marketing/LegalPage.astro";

const githubUrl = "https://github.com/abijith-suresh/interleaf";

const sections = [
  {
    id: "no-data-collection",
    num: "01",
    title: "No data collection",
    body: "Interleaf does not collect, store, or transmit any personal data. We do not use analytics, tracking pixels, or any form of user monitoring.",
  },
  {
    id: "client-side-processing",
    num: "02",
    title: "Client-side processing",
    body: "All PDF operations run entirely in your browser using JavaScript. Your files are never uploaded to any server. Documents are processed in memory and discarded when you close the tab.",
  },
  {
    id: "no-cookies",
    num: "03",
    title: "No cookies",
    body: "Interleaf does not use cookies, local storage, or any other client-side storage mechanism to track users or store personal information.",
  },
  {
    id: "no-third-party-services",
    num: "04",
    title: "No third-party services",
    body: "We do not integrate with any third-party analytics, advertising, or tracking services. Every resource the site loads, including scripts, styles, and fonts, is served from this site itself. No requests are made to third-party domains.",
  },
  {
    id: "open-source",
    num: "05",
    title: "Open source",
    body: "Interleaf is fully open source. You can inspect the complete source code on ",
    link: {
      href: githubUrl,
      label: "GitHub",
      suffix: " to verify these privacy claims for yourself.",
    },
  },
  {
    id: "contact",
    num: "06",
    title: "Contact",
    body: "If you have questions about this privacy policy, you can open an issue on our ",
    link: {
      href: githubUrl,
      label: "GitHub repository",
      suffix: ".",
    },
  },
];
---

<LegalPage
  title="Privacy Policy — Interleaf"
  description="How Interleaf handles your files and browsing data. No uploads, tracking, analytics, or cookies."
  heading="Privacy policy"
  headingId="privacy-title"
  intro="What Interleaf collects and how it handles files in your browser."
  sections={sections}
  />
