---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/shared/Nav.astro";
import Footer from "../components/shared/Footer.astro";
import { pageTransition } from "../utils/transitions";
import "../styles/legal.css";

const githubUrl = "https://github.com/abijith-suresh/interleaf";

const sections = [
  { id: "no-data-collection", num: "01", title: "No data collection" },
  { id: "client-side-processing", num: "02", title: "Client-side processing" },
  { id: "no-cookies", num: "03", title: "No cookies" },
  { id: "no-third-party-services", num: "04", title: "No third-party services" },
  { id: "open-source", num: "05", title: "Open source" },
  { id: "contact", num: "06", title: "Contact" },
];
---

<Layout
  title="Privacy Policy — Interleaf"
  description="How Interleaf handles your files and browsing data. No uploads, tracking, analytics, or cookies."
>
  <div class="marketing-page calm-page legal-page" transition:animate={pageTransition}>
    <Nav />

    <main id="main-content">
      <section class="legal-intro" aria-labelledby="privacy-title">
        <div class="calm-container">
          <div class="legal-intro-copy">
            <h1 id="privacy-title">Privacy policy</h1>
            <p>What Interleaf collects and how it handles files in your browser.</p>
          </div>
        </div>
      </section>

      <section class="legal-content" aria-label="Privacy policy contents">
        <div class="legal-layout calm-container">
          <aside class="contents-rail">
            <nav aria-label="On this page">
              <p class="contents-title">On this page</p>
              <ol>
                {
                  sections.map((section) => (
                    <li>
                      <a href={`#${section.id}`}>
                        <span>{section.num}</span>
                        {section.title}
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </aside>

          <article class="legal-article">
            <section id="no-data-collection" class="legal-block">
              <div class="legal-number">01</div>
              <div>
                <h2>No data collection</h2>
                <p>
                  Interleaf does not collect, store, or transmit any personal data. We do not use
                  analytics, tracking pixels, or any form of user monitoring.
                </p>
              </div>
            </section>

            <section id="client-side-processing" class="legal-block">
              <div class="legal-number">02</div>
              <div>
                <h2>Client-side processing</h2>
                <p>
                  All PDF operations run entirely in your browser using JavaScript. Your files are
                  never uploaded to any server. Documents are processed in memory and discarded
                  when you close the tab.
                </p>
              </div>
            </section>

            <section id="no-cookies" class="legal-block">
              <div class="legal-number">03</div>
              <div>
                <h2>No cookies</h2>
                <p>
                  Interleaf does not use cookies, local storage, or any other client-side storage
                  mechanism to track users or store personal information.
                </p>
              </div>
            </section>

            <section id="no-third-party-services" class="legal-block">
              <div class="legal-number">04</div>
              <div>
                <h2>No third-party services</h2>
                <p>
                  We do not integrate with any third-party analytics, advertising, or tracking
                  services. Every resource the site loads, including scripts, styles, and fonts,
                  is served from this site itself. No requests are made to third-party domains.
                </p>
              </div>
            </section>

            <section id="open-source" class="legal-block">
              <div class="legal-number">05</div>
              <div>
                <h2>Open source</h2>
                <p>
                  Interleaf is fully open source. You can inspect the complete source code on
                  <a href={githubUrl} target="_blank" rel="noopener">GitHub</a> to verify these
                  privacy claims for yourself.
                </p>
              </div>
            </section>

            <section id="contact" class="legal-block">
              <div class="legal-number">06</div>
              <div>
                <h2>Contact</h2>
                <p>
                  If you have questions about this privacy policy, you can open an issue on our
                  <a href={githubUrl} target="_blank" rel="noopener">GitHub repository</a>.
                </p>
              </div>
            </section>
          </article>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Layout>
