---
import LegalPage from "../components/marketing/LegalPage.astro";

const githubUrl = "https://github.com/abijith-suresh/interleaf";

const sections = [
  {
    id: "no-data-collection",
    num: "01",
    title: "No data collection",
    body: "Interleaf does not collect personal data, and it does not transmit your files. We do not use analytics, tracking pixels, or any form of user monitoring.",
  },
  {
    id: "local-processing",
    num: "02",
    title: "Local processing",
    body: "All PDF operations run entirely in your browser using JavaScript. Your files are never uploaded to any server. Documents are processed in memory and discarded when you close the tab.",
  },
  {
    id: "no-cookies",
    num: "03",
    title: "No cookies",
    body: "Interleaf does not set cookies. It does not use local storage or other browser storage to track users or store personal information.",
  },
  {
    id: "no-third-party-services",
    num: "04",
    title: "No third-party services",
    body: "We do not integrate with any third-party analytics, advertising, or tracking services. Every resource the site loads, including scripts, styles, and fonts, is served from this site itself. Interleaf does not request resources from third-party domains. A security policy sent with each page also tells your browser to block connections to other sites.",
  },
  {
    id: "hosting",
    num: "05",
    title: "Hosting",
    body: "Vercel hosts this site. As with any website, the host receives standard request metadata when a page loads, such as your IP address and browser user agent, and may keep server logs. Interleaf does not use this data. It never includes your files.",
  },
  {
    id: "open-source",
    num: "06",
    title: "Open source",
    body: "Interleaf is fully open source. You can inspect the complete source code on ",
    link: {
      href: githubUrl,
      label: "GitHub",
      suffix: " to verify these privacy claims for yourself.",
    },
  },
  {
    id: "contact",
    num: "07",
    title: "Contact",
    body: "If you have questions about this privacy policy, you can open an issue on our ",
    link: {
      href: githubUrl,
      label: "GitHub repository",
      suffix: ".",
    },
  },
];
---

<LegalPage
  title="Privacy policy — Interleaf"
  description="How Interleaf handles your files and browsing data, and what the host receives. No uploads, analytics, or cookies."
  heading="Privacy policy"
  headingId="privacy-title"
  intro="What Interleaf collects and how it handles files in your browser."
  sections={sections}
  />
