---
import LegalPage from "../components/marketing/LegalPage.astro";

const githubUrl = "https://github.com/abijith-suresh/interleaf";

const sections = [
  {
    id: "your-files",
    title: "Your files",
    body: "Interleaf works on your files in your browser and never uploads them.",
  },
  {
    id: "no-tracking",
    title: "No tracking",
    body: "Interleaf has no analytics, ads, or cookies, and collects no personal data.",
  },
  {
    id: "no-third-parties",
    title: "No third parties",
    body: "Interleaf loads every script, style, and font from its own domain.",
  },
  {
    id: "hosting",
    title: "Hosting",
    body: "Vercel hosts the site. Like any host, it sees request data such as your IP address and may keep logs. Interleaf does not use this data.",
  },
  {
    id: "source-and-contact",
    title: "Source and contact",
    body: "Check these claims in the source code, or ask a question, on ",
    link: {
      href: githubUrl,
      label: "GitHub",
      suffix: ".",
    },
  },
];
---

<LegalPage
  title="Privacy policy | Interleaf"
  description="Interleaf never uploads your files and has no analytics, ads, or cookies."
  heading="Privacy policy"
  headingId="privacy-title"
  intro="How Interleaf handles your files and data."
  sections={sections}
  />
