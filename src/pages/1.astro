---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const path = (segment = "") => `${base}${segment}`;
const normalizePath = (value: string) => value.replace(/\/+$/, "") || "/";
const isCurrent = (segment = "") =>
  normalizePath(Astro.url.pathname) === normalizePath(path(segment));

const experiments = ["1", "2", "3", "4", "5"];

const operations = [
  {
    num: "01",
    title: "Merge",
    text: "Combine multiple PDFs into one working set.",
  },
  {
    num: "02",
    title: "Extract",
    text: "Select pages and export them as a new PDF.",
  },
  {
    num: "03",
    title: "Reorder",
    text: "Move pages into the order you need with drag and drop.",
  },
  {
    num: "04",
    title: "Rotate",
    text: "Turn an individual page or a selection in 90-degree steps.",
  },
  {
    num: "05",
    title: "Delete",
    text: "Mark pages for deletion before you export.",
  },
  {
    num: "06",
    title: "Unlock",
    text: "Open a password-protected PDF with an in-browser prompt.",
  },
];
---

<Layout
  title="Interleaf - Browser PDF tools"
  description="Six PDF operations that run in your browser. Merge, extract, reorder, rotate, delete, and unlock files with no uploads and no servers."
>
  <div class="swiss-page">
    <div class="top-accent" aria-hidden="true"></div>

    <header class="swiss-header">
      <div class="swiss-header-inner">
        <a class="brand" href={path()} aria-label="Interleaf home">
          <span>Interleaf</span><span class="brand-mark" aria-hidden="true">/ PDF</span>
        </a>

        <p class="header-context">Landing page / bright Swiss utility</p>

        <nav class="experiment-nav" aria-label="Design experiments">
          <span class="experiment-label">Explore</span>
          <a
            class:list={["route-link route-link-main", isCurrent() && "is-current"]}
            href={path()}
            aria-current={isCurrent() ? "page" : undefined}
            >/</a
          >
          {
            experiments.map((experiment) => (
              <a
                class:list={["route-link", isCurrent(experiment) && "is-current"]}
                href={path(experiment)}
                aria-current={isCurrent(experiment) ? "page" : undefined}
              >
                {experiment.padStart(2, "0")}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-rail" aria-label="Experiment details">
            <span class="hero-rail-number">01</span>
            <span class="hero-rail-rule" aria-hidden="true"></span>
            <span class="hero-rail-copy">Landing page<br />Design study 2026</span>
          </div>

          <div class="hero-copy">
            <p class="micro-label">PDF / browser tool</p>
            <h1 id="hero-title">PDF pages.<br /><span>In order.</span></h1>
            <p class="hero-intro">
              Merge, extract, reorder, rotate, delete, or unlock a PDF in your browser. No uploads.
              No servers.
            </p>
            <a class="primary-action" href={path("app")}>
              <span>Open Editor</span><span class="action-arrow" aria-hidden="true">↗</span>
            </a>
          </div>

          <aside class="hero-index" aria-label="Six supported PDF operations">
            <div class="index-topline">
              <span>Tool index</span>
              <span>01—06</span>
            </div>
            <div class="index-count" aria-hidden="true">06</div>
            <p class="index-title">PDF operations</p>
            <ol class="index-list">
              {
                operations.map((operation) => (
                  <li>
                    <span>{operation.num}</span><span>{operation.title}</span>
                  </li>
                ))
              }
            </ol>
          </aside>
        </div>

        <div class="hero-baseline">
          <p><span class="baseline-mark" aria-hidden="true">+</span> Start with a file on your device.</p>
          <p>Work on the pages. Export the result.</p>
          <p class="baseline-status"><span aria-hidden="true"></span> Runs in browser</p>
        </div>
      </section>

      <section class="operations-section" aria-labelledby="operations-title">
        <div class="section-intro">
          <p class="section-index">02 / 05</p>
          <div class="section-heading-wrap">
            <p class="micro-label">What you can do</p>
            <h2 id="operations-title">Six actions<br /><span>for one file.</span></h2>
          </div>
          <p class="section-description">
            Keep the page order visible while you make the change you came to make.
          </p>
        </div>

        <ol class="operation-list">
          {
            operations.map((operation) => (
              <li class="operation-row">
                <span class="operation-number">{operation.num}</span>
                <h3>{operation.title}</h3>
                <p>{operation.text}</p>
                <span class="operation-end" aria-hidden="true">+</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="local-section" aria-labelledby="local-title">
        <div class="local-grid">
          <p class="section-index">03 / WHERE IT RUNS</p>
          <div class="local-copy">
            <p class="micro-label">The file stays put</p>
            <h2 id="local-title">Open it here.<br /><span>Keep it here.</span></h2>
            <p>
              Interleaf reads and changes your PDF in the browser. There is no upload step and no
              server processing.
            </p>
          </div>
          <ol class="local-path" aria-label="How a PDF moves through Interleaf">
            <li><span>01</span><strong>Your device</strong></li>
            <li class="path-connector" aria-hidden="true">↓</li>
            <li><span>02</span><strong>Your browser</strong></li>
            <li class="path-connector" aria-hidden="true">↓</li>
            <li><span>03</span><strong>Your device</strong></li>
          </ol>
        </div>
      </section>

      <section class="closing-section" aria-labelledby="closing-title">
        <div class="closing-grid">
          <p class="section-index">04 / READY WHEN YOU ARE</p>
          <h2 id="closing-title">Make the pages<br /><span>fit.</span></h2>
          <p class="closing-copy">Open the editor when you have a PDF to fix.</p>
        </div>
      </section>
    </main>

    <footer class="swiss-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand" href={path()} aria-label="Interleaf home">
            <span>Interleaf</span><span class="brand-mark" aria-hidden="true">/ PDF</span>
          </a>
          <p>Six PDF operations in the browser.<br />No uploads. No servers.</p>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
          <a href={path("features")}>Features</a>
          <a href={path("about")}>About</a>
          <a href={path("faq")}>FAQ</a>
          <a href={path("privacy")}>Privacy</a>
          <a href={path("terms")}>Terms</a>
        </nav>

        <p class="footer-year">© 2026<br />Interleaf</p>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .swiss-page {
    --swiss-ink: #111;
    --swiss-red: #ff1f1f;
    --swiss-paper: #fff;
    --swiss-rule: #d4d4d0;
    --swiss-muted: #666;
    --swiss-gutter: clamp(1.25rem, 4vw, 5rem);
    --swiss-max: 90rem;
    min-height: 100vh;
    background: var(--swiss-paper);
    color: var(--swiss-ink);
    font-family: var(--font-body);
  }

  .swiss-page,
  .swiss-page * {
    box-sizing: border-box;
  }

  .swiss-page a {
    color: inherit;
  }

  .top-accent {
    height: 0.35rem;
    background: var(--swiss-red);
  }

  .swiss-header {
    border-bottom: 1px solid var(--swiss-ink);
  }

  .swiss-header-inner,
  .hero-grid,
  .hero-baseline,
  .section-intro,
  .operation-list,
  .local-grid,
  .closing-grid,
  .footer-grid {
    width: min(calc(100% - (var(--swiss-gutter) * 2)), var(--swiss-max));
    margin-inline: auto;
  }

  .swiss-header-inner {
    min-height: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--swiss-ink);
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-mark {
    color: var(--swiss-red);
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .header-context,
  .experiment-label,
  .route-link,
  .micro-label,
  .section-index,
  .hero-rail-copy,
  .index-topline,
  .index-title,
  .baseline-status,
  .operation-number,
  .footer-links,
  .footer-year {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .header-context {
    flex: 1;
    margin: 0;
    color: var(--swiss-muted);
  }

  .experiment-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .experiment-label {
    margin-right: 0.5rem;
    color: var(--swiss-muted);
  }

  .route-link {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    color: var(--swiss-muted);
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .route-link:hover,
  .route-link.is-current {
    border-color: var(--swiss-ink);
    color: var(--swiss-ink);
  }

  .route-link-main {
    color: var(--swiss-red);
  }

  .route-link:focus-visible,
  .brand:focus-visible,
  .primary-action:focus-visible,
  .footer-links a:focus-visible {
    outline: 2px solid var(--swiss-red);
    outline-offset: 4px;
  }

  .hero {
    border-bottom: 1px solid var(--swiss-ink);
    padding: clamp(4.5rem, 10vw, 9rem) 0 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
  }

  .hero-rail {
    grid-column: 1 / span 2;
    min-height: 25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-right: 1px solid var(--swiss-rule);
    padding-right: 1.25rem;
  }

  .hero-rail-number {
    color: var(--swiss-red);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 0.85;
  }

  .hero-rail-rule {
    width: 1px;
    flex: 1;
    margin: 1.5rem 0;
    background: var(--swiss-rule);
  }

  .hero-rail-copy {
    color: var(--swiss-muted);
  }

  .hero-copy {
    grid-column: 3 / span 7;
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }

  .micro-label {
    margin: 0 0 1.5rem;
    color: var(--swiss-red);
    font-weight: 600;
  }

  .hero-copy h1,
  .section-heading-wrap h2,
  .local-copy h2,
  .closing-grid h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 0.82;
  }

  .hero-copy h1 {
    max-width: 11ch;
    font-size: clamp(5.25rem, 12.5vw, 12rem);
  }

  .hero-copy h1 span,
  .section-heading-wrap h2 span,
  .local-copy h2 span,
  .closing-grid h2 span {
    color: var(--swiss-red);
  }

  .hero-intro {
    max-width: 34rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    border-left: 0.35rem solid var(--swiss-red);
    padding-left: 1.25rem;
    color: var(--swiss-ink);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.35;
  }

  .primary-action {
    display: inline-flex;
    min-height: 3.5rem;
    align-items: center;
    gap: 2rem;
    margin-top: 2.5rem;
    padding: 0.9rem 1.1rem 0.9rem 1.4rem;
    background: var(--swiss-red);
    color: var(--swiss-paper);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .primary-action:hover {
    background: var(--swiss-ink);
  }

  .primary-action:active {
    transform: translateY(2px);
  }

  .action-arrow {
    display: inline-grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid currentColor;
    font-size: 1rem;
    letter-spacing: 0;
    line-height: 1;
  }

  .hero-index {
    grid-column: 11 / -1;
    min-height: 25rem;
    background: var(--swiss-red);
    padding: 1.25rem;
    color: var(--swiss-paper);
  }

  .index-topline {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 55%);
    padding-bottom: 0.85rem;
  }

  .index-count {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(6rem, 10vw, 10rem);
    line-height: 0.7;
  }

  .index-title {
    margin: 1.25rem 0 2rem;
    font-weight: 600;
  }

  .index-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index-list li {
    display: flex;
    gap: 0.7rem;
    border-top: 1px solid rgb(255 255 255 / 55%);
    padding-top: 0.6rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .index-list li span:first-child {
    width: 1.5rem;
    font-size: 0.65rem;
    opacity: 0.75;
  }

  .hero-baseline {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--swiss-rule);
    padding-top: 1.15rem;
    padding-bottom: 1.15rem;
    color: var(--swiss-muted);
    font-size: 0.77rem;
    line-height: 1.4;
  }

  .hero-baseline p {
    margin: 0;
  }

  .hero-baseline p:nth-child(2) {
    color: var(--swiss-ink);
  }

  .baseline-mark {
    display: inline-block;
    margin-right: 0.35rem;
    color: var(--swiss-red);
    font-size: 1rem;
    font-weight: 600;
  }

  .baseline-status {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    color: var(--swiss-ink);
    font-size: 0.65rem;
    font-weight: 600;
  }

  .baseline-status span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--swiss-red);
  }

  .operations-section,
  .local-section,
  .closing-section {
    padding: clamp(5rem, 10vw, 9rem) 0;
  }

  .section-intro,
  .local-grid,
  .closing-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  .section-index {
    grid-column: 1 / span 2;
    margin: 0;
    color: var(--swiss-red);
    font-weight: 600;
  }

  .section-heading-wrap {
    grid-column: 3 / span 6;
  }

  .section-heading-wrap .micro-label,
  .local-copy .micro-label {
    margin-bottom: 1.25rem;
  }

  .section-heading-wrap h2,
  .local-copy h2,
  .closing-grid h2 {
    font-size: clamp(4rem, 8vw, 8rem);
  }

  .section-description {
    grid-column: 10 / -1;
    align-self: end;
    max-width: 15rem;
    margin: 0;
    color: var(--swiss-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .operation-list {
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--swiss-ink);
    padding: 0;
    list-style: none;
  }

  .operation-row {
    display: grid;
    grid-template-columns: 1fr 3fr 6fr 1fr;
    column-gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: baseline;
    border-bottom: 1px solid var(--swiss-rule);
    padding: 1.5rem 0;
  }

  .operation-row:last-child {
    border-bottom-color: var(--swiss-ink);
  }

  .operation-number {
    color: var(--swiss-red);
    font-weight: 600;
  }

  .operation-row h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 0.9;
  }

  .operation-row p {
    max-width: 31rem;
    margin: 0;
    color: var(--swiss-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .operation-end {
    justify-self: end;
    color: var(--swiss-red);
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 0.8;
  }

  .local-section {
    border-top: 1px solid var(--swiss-ink);
    border-bottom: 1px solid var(--swiss-ink);
    background: #fafafa;
  }

  .local-copy {
    grid-column: 3 / span 6;
  }

  .local-copy > p:last-child {
    max-width: 28rem;
    margin: 2.25rem 0 0;
    color: var(--swiss-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .local-path {
    grid-column: 10 / -1;
    align-self: end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .local-path li:not(.path-connector) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border-top: 1px solid var(--swiss-rule);
    padding: 0.85rem 0;
  }

  .local-path li span {
    color: var(--swiss-red);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .local-path li strong {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .local-path .path-connector {
    height: 1rem;
    padding-left: 0.1rem;
    color: var(--swiss-red);
    font-size: 1.25rem;
    line-height: 0.7;
  }

  .closing-section {
    padding-bottom: clamp(6rem, 12vw, 11rem);
  }

  .closing-grid h2 {
    grid-column: 3 / span 7;
  }

  .closing-copy {
    grid-column: 10 / -1;
    align-self: end;
    max-width: 13rem;
    margin: 0;
    color: var(--swiss-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .swiss-footer {
    border-top: 0.35rem solid var(--swiss-red);
    background: var(--swiss-ink);
    color: var(--swiss-paper);
    padding: 3rem 0 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 2rem;
    align-items: start;
  }

  .footer-brand .brand {
    color: var(--swiss-paper);
  }

  .footer-brand p {
    margin: 1.25rem 0 0;
    color: #bdbdbd;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--swiss-paper);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-links a:hover {
    color: var(--swiss-red);
  }

  .footer-year {
    margin: 0;
    color: #bdbdbd;
    text-align: right;
  }

  @media (max-width: 899px) {
    .header-context {
      display: none;
    }

    .hero {
      padding-top: 4rem;
    }

    .hero-rail {
      grid-column: 1 / -1;
      min-height: auto;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--swiss-rule);
      padding: 0 0 1rem;
    }

    .hero-rail-rule {
      width: 2rem;
      height: 1px;
      flex: none;
      margin: 0;
    }

    .hero-rail-copy {
      br {
        display: none;
      }
    }

    .hero-copy {
      grid-column: 1 / span 8;
    }

    .hero-index {
      grid-column: 10 / -1;
      min-height: auto;
    }

    .hero-baseline {
      grid-template-columns: 1fr 1fr;
    }

    .baseline-status {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .section-heading-wrap,
    .local-copy,
    .closing-grid h2 {
      grid-column: 3 / span 7;
    }

    .section-description,
    .local-path,
    .closing-copy {
      grid-column: 10 / -1;
    }

    .operation-row {
      grid-template-columns: 1fr 3fr 1fr;
    }

    .operation-row p {
      grid-column: 2 / -1;
      margin-top: 0.75rem;
    }

    .operation-end {
      grid-column: 3;
      grid-row: 1;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-links {
      justify-content: flex-end;
    }

    .footer-year {
      grid-column: 1 / -1;
      border-top: 1px solid #444;
      padding-top: 1rem;
      text-align: left;
    }
  }

  @media (max-width: 599px) {
    .swiss-header-inner {
      align-items: flex-start;
      flex-direction: column;
      padding: 0.85rem 0;
    }

    .experiment-nav {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid var(--swiss-rule);
      padding-top: 0.5rem;
    }

    .experiment-label {
      margin-right: auto;
    }

    .route-link {
      min-width: 2.15rem;
      min-height: 2.75rem;
    }

