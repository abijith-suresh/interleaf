---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const path = (segment = "") => `${base}${segment}`;
const normalizePath = (value: string) => value.replace(/\/+$/, "") || "/";
const isCurrent = (segment = "") =>
  normalizePath(Astro.url.pathname) === normalizePath(path(segment));

const experiments = ["1", "2", "3", "4", "5"];
---

<Layout
  title="Interleaf | Put the document right"
  description="Make a PDF's pages right in your browser, without sending the file away."
>
  <div class="quiet-page">
    <header class="quiet-header">
      <div class="quiet-shell quiet-header-inner">
        <a class="quiet-wordmark" href={path()} aria-label="Interleaf home">
          <span>interleaf</span><span class="quiet-mark" aria-hidden="true"></span>
        </a>

        <nav class="quiet-nav" aria-label="Design directions">
          <a class="quiet-home-link" href={path()} aria-label="Home">home</a>
          {
            experiments.map((experiment) => (
              <a
                href={path(experiment)}
                aria-current={isCurrent(experiment) ? "page" : undefined}
              >
                {experiment}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main-content">
      <section class="quiet-hero quiet-shell" aria-labelledby="hero-title">
        <div class="quiet-hero-content">
          <span class="quiet-signal" aria-hidden="true"></span>
          <h1 id="hero-title">Put the <span>document right.</span></h1>
          <p class="quiet-proposition">
            Make a PDF's pages right in your browser, without sending the file away.
          </p>
          <a class="quiet-action" href={path("app")}>
            <span>Open editor</span>
            <span class="quiet-action-dot" aria-hidden="true"></span>
          </a>
        </div>
      </section>

      <section class="quiet-support quiet-shell" aria-labelledby="support-title">
        <h2 id="support-title">For the last edit.</h2>
        <p>
          Open a PDF, make the page change, and leave with the file you meant to send. Your file
          stays on your device.
        </p>
      </section>
    </main>

    <footer class="quiet-footer">
      <div class="quiet-shell quiet-footer-inner">
        <a class="quiet-footer-wordmark" href={path()} aria-label="Interleaf home">interleaf</a>
        <span class="quiet-footer-year">© 2026</span>
        <nav class="quiet-footer-nav" aria-label="Footer navigation">
          <a href={path("about")}>About</a>
          <a href={path("privacy")}>Privacy</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .quiet-page {
    --quiet-ink: #292722;
    --quiet-muted: #736d64;
    --quiet-cream: #f5f1e9;
    --quiet-rule: #d9d2c8;
    --quiet-red: #ef2d24;
    --quiet-shell: min(100% - 3rem, 86rem);
    min-height: 100vh;
    background: var(--quiet-cream);
    color: var(--quiet-ink);
    font-family: var(--font-body);
  }

  .quiet-page,
  .quiet-page * {
    box-sizing: border-box;
  }

  .quiet-shell {
    width: var(--quiet-shell);
    margin-inline: auto;
  }

  .quiet-page a {
    color: inherit;
  }

  .quiet-header {
    border-bottom: 1px solid var(--quiet-rule);
  }

  .quiet-header-inner {
    min-height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .quiet-wordmark,
  .quiet-footer-wordmark {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.48rem;
    color: var(--quiet-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.25rem;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
  }

  .quiet-mark {
    width: 0.42rem;
    height: 0.42rem;
    margin-top: -0.35rem;
    border-radius: 50%;
    background: var(--quiet-red);
  }

  .quiet-nav,
  .quiet-footer-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.45rem, 1.15vw, 1.1rem);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .quiet-nav a,
  .quiet-footer-nav a {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--quiet-muted);
    text-decoration: none;
  }

  .quiet-nav a:hover,
  .quiet-footer-nav a:hover,
  .quiet-nav a[aria-current="page"] {
    color: var(--quiet-ink);
  }

  .quiet-nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    left: 0;
    height: 0.18rem;
    background: var(--quiet-red);
    content: "";
  }

  .quiet-hero {
    min-height: min(47rem, calc(100svh - 5.5rem));
    display: flex;
    align-items: center;
    padding-top: clamp(5rem, 12vh, 9rem);
    padding-bottom: clamp(5rem, 12vh, 9rem);
  }

  .quiet-hero-content {
    width: min(100%, 70rem);
    margin-left: min(10vw, 9rem);
  }

  .quiet-signal {
    display: block;
    width: 0.38rem;
    height: 4.5rem;
    margin-bottom: clamp(2rem, 4vw, 3.75rem);
    background: var(--quiet-red);
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -0.075em;
  }

  h1 {
    max-width: 10ch;
    font-size: clamp(4.25rem, 9.5vw, 9.3rem);
    line-height: 0.89;
    text-wrap: balance;
  }

  h1 span {
    display: block;
    color: var(--quiet-muted);
    font-style: italic;
  }

  .quiet-proposition {
    max-width: 31rem;
    margin-top: clamp(2.2rem, 4vw, 3rem);
    color: var(--quiet-muted);
    font-size: clamp(1.05rem, 1.55vw, 1.3rem);
    letter-spacing: -0.018em;
    line-height: 1.45;
  }

  .quiet-action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 1.15rem;
    margin-top: 2.25rem;
    padding: 0.65rem 1.1rem 0.65rem 1.3rem;
    border: 1px solid var(--quiet-ink);
    background: var(--quiet-ink);
    color: var(--quiet-cream) !important;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .quiet-action:hover {
    background: transparent;
    color: var(--quiet-ink) !important;
  }

  .quiet-action-dot {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: var(--quiet-red);
    transition: transform 180ms ease;
  }

  .quiet-action:hover .quiet-action-dot {
    transform: translateX(0.22rem);
  }

  .quiet-support {
    display: grid;
    grid-template-columns: minmax(12rem, 0.78fr) minmax(0, 1fr);
    gap: clamp(2rem, 9vw, 10rem);
    padding-top: clamp(3.75rem, 8vw, 7rem);
    padding-bottom: clamp(5rem, 11vw, 9rem);
    border-top: 1px solid var(--quiet-rule);
  }

  .quiet-support h2 {
    max-width: 8ch;
    font-size: clamp(2.6rem, 5vw, 5.2rem);
    line-height: 0.94;
  }

  .quiet-support p {
    max-width: 31rem;
    align-self: end;
    color: var(--quiet-muted);
    font-size: clamp(1.05rem, 1.45vw, 1.2rem);
    letter-spacing: -0.012em;
    line-height: 1.55;
  }

  .quiet-footer {
    border-top: 1px solid var(--quiet-rule);
  }

  .quiet-footer-inner {
    min-height: 5.75rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .quiet-footer-wordmark {
    font-size: 1.05rem;
  }

  .quiet-footer-year {
    color: var(--quiet-muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .quiet-footer-nav {
    justify-content: flex-end;
  }

  .quiet-page a:focus-visible {
    outline: 2px solid var(--quiet-ink);
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .quiet-page {
      --quiet-shell: min(100% - 2rem, 86rem);
    }

    .quiet-header-inner {
      min-height: 4.75rem;
      gap: 0.75rem;
    }

    .quiet-wordmark {
      font-size: 1.1rem;
    }

    .quiet-nav {
      gap: 0.05rem;
      font-size: 0.62rem;
      letter-spacing: 0.05em;
    }

    .quiet-nav a {
      padding-inline: 0.25rem;
    }

    .quiet-nav a[aria-current="page"]::after {
      bottom: 0.3rem;
    }

    .quiet-hero {
      min-height: 0;
      align-items: flex-start;
      padding-top: 5.5rem;
      padding-bottom: 6.5rem;
    }

    .quiet-hero-content {
      margin-left: 0;
    }

    .quiet-signal {
      width: 0.32rem;
      height: 3.25rem;
      margin-bottom: 2.25rem;
    }

    h1 {
      max-width: 8.3ch;
      font-size: clamp(3.65rem, 17vw, 5.4rem);
      line-height: 0.91;
    }

    .quiet-proposition {
      max-width: 22rem;
      margin-top: 2rem;
      font-size: 1.08rem;
    }

    .quiet-action {
      margin-top: 2rem;
    }

    .quiet-support {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding-top: 3.5rem;
      padding-bottom: 5.5rem;
    }

    .quiet-support h2 {
      max-width: none;
      font-size: clamp(2.65rem, 13vw, 4rem);
    }

    .quiet-support p {
      max-width: 25rem;
      font-size: 1.05rem;
    }

    .quiet-footer-inner {
      min-height: 7.5rem;
      grid-template-columns: 1fr 1fr;
      row-gap: 0.5rem;
      padding-top: 1.2rem;
      padding-bottom: 1.2rem;
    }

    .quiet-footer-year {
      justify-self: end;
    }

    .quiet-footer-nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quiet-page *,
    .quiet-page *::before,
    .quiet-page *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
