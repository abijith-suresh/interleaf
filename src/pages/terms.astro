---
import LegalPage from "../components/marketing/LegalPage.astro";

const githubUrl = "https://github.com/abijith-suresh/interleaf";

const sections = [
  {
    id: "acceptance",
    num: "01",
    title: "Acceptance of terms",
    body: "By accessing and using Interleaf, you agree to be bound by these terms. If you do not agree, please do not use the application.",
  },
  {
    id: "no-warranty",
    num: "02",
    title: "No warranty",
    body: 'Interleaf is provided "as is" without warranty of any kind, express or implied. We make no guarantees regarding the accuracy, reliability, or completeness of PDF operations performed by the tool.',
  },
  {
    id: "limitation",
    num: "03",
    title: "Limitation of liability",
    body: "In no event shall the authors or contributors be liable for any damages arising from the use or inability to use Interleaf, including but not limited to data loss or corruption of PDF files.",
  },
  {
    id: "open-source-license",
    num: "04",
    title: "Open source license",
    body: "Interleaf is open-source software. The source code is available on ",
    link: {
      href: githubUrl,
      label: "GitHub",
      suffix:
        " and is subject to its respective license terms. You are free to inspect, modify, and distribute the code in accordance with the license.",
    },
  },
  {
    id: "permitted-use",
    num: "05",
    title: "Permitted use",
    body: "You may use Interleaf for any lawful purpose, including personal and commercial use. You are solely responsible for the content of the PDF files you process using the tool.",
  },
  {
    id: "changes",
    num: "06",
    title: "Changes to terms",
    body: "We reserve the right to modify these terms at any time. Changes will be reflected on this page. Continued use of Interleaf after changes constitutes acceptance of the updated terms.",
  },
];
---

<LegalPage
  title="Terms of Service — Interleaf"
  description="The terms that apply when you use Interleaf. Free to use for any lawful purpose, with no warranty."
  heading="Terms of service"
  headingId="terms-title"
  intro="The terms that apply when you use Interleaf."
  sections={sections}
  />
