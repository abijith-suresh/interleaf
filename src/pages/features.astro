---
import MarketingLayout from "../components/marketing/MarketingLayout.astro";
import ArrowIcon from "../components/shared/ArrowIcon.astro";

const base = import.meta.env.BASE_URL;

const capabilities = [
  {
    title: "Get a document together",
    description:
      "Combine PDFs into one working document, or pull selected pages into a separate file.",
  },
  {
    title: "Shape the pages",
    description:
      "Arrange pages by dragging, turn them in 90° steps, and mark the ones you no longer need before export.",
  },
  {
    title: "Open protected files",
    description: "Use an in-browser password prompt to unlock a protected PDF and keep working.",
  },
];
---

<MarketingLayout
  title="Features — Interleaf"
  description="A local workspace for bringing PDF files together, arranging their pages, and opening protected documents."
  currentPage="features"
>
  <section class="features-hero" aria-labelledby="features-title">
    <div class="hero-grid marketing-container">
      <h1 id="features-title">Make the<br /><span>document ready.</span></h1>

      <div class="hero-copy">
        <p>
          Interleaf is a local workspace for the work that happens before a PDF is ready to share.
          Bring files together, shape their pages, and open protected documents in the browser.
        </p>
        <a class="hero-action" href={`${base}app`}>
          Open editor <span aria-hidden="true"><ArrowIcon /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="capability-section" aria-labelledby="capability-title">
    <div class="marketing-container">
      <div class="section-intro">
        <p class="section-index">The work in between</p>
        <h2 id="capability-title">A few careful steps before the file goes out.</h2>
      </div>

      <div class="capability-list">
        {
          capabilities.map((capability) => (
            <article class="capability">
              <span class="capability-marker" aria-hidden="true"></span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="local-note marketing-container" aria-label="Local processing">
    <span class="local-note-marker" aria-hidden="true"></span>
    <p>
      <strong>Your files stay with you.</strong> Interleaf processes documents in your browser.
      Nothing is uploaded.
    </p>
  </section>
</MarketingLayout>

<style>
  a:focus-visible {
    outline: 2px solid var(--marketing-accent);
    outline-offset: 4px;
  }

  .features-hero {
    display: grid;
    align-items: end;
    min-height: min(31rem, calc(100svh - 4.75rem));
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3rem, 7vw, 5.25rem);
    border-bottom: 1px solid var(--marketing-rule);
  }

  .hero-grid {
    display: grid;
    width: min(calc(100% - 2rem), 72rem);
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: end;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 {
    max-width: 48rem;
    font-size: clamp(3.75rem, 8.7vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.085em;
    line-height: 0.88;
    text-wrap: balance;
  }

  h1 span {
    color: var(--marketing-accent);
  }

  .hero-copy {
    max-width: 26rem;
    padding-bottom: 0.25rem;
  }

  .hero-copy > p {
    color: var(--marketing-muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
    padding: 0.8rem 1rem 0.8rem 1.15rem;
    border-radius: 0.45rem;
    background: var(--marketing-accent);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .hero-action span {
    font-size: 1.1rem;
    line-height: 1;
  }

  .hero-action:hover {
    background: var(--marketing-ink);
    transform: translateY(-1px);
  }

  .hero-action:active {
    transform: translateY(0);
  }

  .capability-section {
    padding-block: clamp(3.75rem, 8vw, 6.5rem);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(9rem, 0.5fr) minmax(0, 1.5fr);
    gap: 2rem;
    align-items: start;
  }

  .section-index {
    padding-top: 0.55rem;
    color: var(--marketing-muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 34rem;
    font-size: clamp(2rem, 4.3vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .capability-list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--marketing-ink);
  }

  .capability {
    display: grid;
    grid-template-columns: 1rem minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--marketing-rule);
  }

  .capability:last-child {
    border-bottom-color: var(--marketing-ink);
  }

  .capability-marker,
  .local-note-marker {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--marketing-accent);
  }

  h3 {
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .capability p {
    max-width: 32rem;
    color: var(--marketing-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .local-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
    padding-block: 1.25rem;
    border-top: 1px solid var(--marketing-rule);
    color: var(--marketing-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .local-note strong {
    color: var(--marketing-ink);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .features-hero {
      min-height: auto;
      padding-block: 3.5rem 3.25rem;
    }

    .hero-grid,
    .section-intro {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-copy {
      max-width: 30rem;
    }

    .capability {
      grid-template-columns: 1rem minmax(0, 1fr);
      gap: 0.85rem 1rem;
      padding-block: 1.35rem;
    }

    .capability p {
      grid-column: 2;
    }

    .local-note {
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-action {
      transition: none;
    }

    .hero-action:hover,
    .hero-action:active {
      transform: none;
    }
  }
</style>
