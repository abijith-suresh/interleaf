---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/shared/Nav.astro";
import Footer from "../components/shared/Footer.astro";
import PageHeader from "../components/shared/PageHeader.astro";
import NumberedRow from "../components/shared/NumberedRow.astro";
import BottomCTA from "../components/shared/BottomCTA.astro";
import { contentSlide } from "../utils/transitions";

const base = import.meta.env.BASE_URL;

const features = [
  {
    num: "01",
    title: "Merge",
    desc: "Combine multiple PDF files into a single document.",
    details: [
      "Add more PDFs at any point",
      "Keeps page order under your control",
      "Runs fully in-browser",
    ],
  },
  {
    num: "02",
    title: "Split",
    desc: "Extract selected pages into a new PDF.",
    details: ["Select any subset of pages", "Exports a separate PDF", "Preserves your page order"],
  },
  {
    num: "03",
    title: "Reorder",
    desc: "Drag and drop pages to arrange them in any order.",
    details: ["Visual page thumbnails", "Drag-and-drop interface", "Instant preview"],
  },
  {
    num: "04",
    title: "Rotate",
    desc: "Rotate any page to the correct orientation.",
    details: [
      "Rotate in 90 degree steps",
      "Per-page or bulk rotation",
      "Immediate visual confirmation",
    ],
  },
  {
    num: "05",
    title: "Delete",
    desc: "Remove unwanted pages cleanly from any PDF.",
    details: ["Click to select pages", "Bulk deletion"],
  },
];
---

<Layout
  title="Features — Interleaf"
  description="Merge, split, reorder, rotate, and delete PDFs. Five powerful operations, all running client-side in your browser."
>
  <div class="page-wrapper" transition:animate={contentSlide}>
    <Nav currentPage="features" />

    <main>
      <PageHeader label="Product" title="Everything<br />you need." />

      <section class="px-6 md:px-16 lg:px-24 py-16">
        <div class="max-w-7xl mx-auto">
          <div class="border-t-2 border-primary">
            {
              features.map((f, i) => (
                <NumberedRow
                  num={f.num}
                  title={f.title}
                  titleClass={i === features.length - 1 ? "text-accent" : ""}
                  isLast={i === features.length - 1}
                  staggerClass={`stagger-${Math.min(i + 1, 8)}`}
                >
                  <p>{f.desc}</p>
                  <ul class="mt-3 space-y-1">
                    {f.details.map((d) => (
                      <li class="text-sm text-muted font-light">{d}</li>
                    ))}
                  </ul>
                </NumberedRow>
              ))
            }
          </div>
        </div>
      </section>

      <section class="px-6 md:px-16 lg:px-24 py-16">
        <div class="max-w-7xl mx-auto border-l-4 border-accent pl-6 animate-on-scroll">
          <p class="body-text text-sm max-w-2xl">
            Every operation runs entirely in your browser. No files are uploaded to any server. Your
            documents never leave your device.
          </p>
        </div>
      </section>

      <BottomCTA heading="Try it now." buttonText="Open Editor" buttonHref={`${base}app`} />
    </main>

    <Footer />
  </div>
</Layout>
