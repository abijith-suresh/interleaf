---
import MarketingLayout from "../components/marketing/MarketingLayout.astro";
import ArrowIcon from "../components/shared/ArrowIcon.astro";
import MarketingHero from "../components/marketing/MarketingHero.astro";

const base = import.meta.env.BASE_URL;

const capabilities = [
  {
    title: "Get a document together",
    description:
      "Turn PNG or JPEG images into a PDF, combine PDFs into one working document, or pull selected pages into a separate file.",
  },
  {
    title: "Shape the pages",
    description:
      "Arrange pages by dragging, turn them in 90° steps, and mark the ones you no longer need before export.",
  },
  {
    title: "Review the document",
    description:
      "Inspect pages one at a time with previous/next navigation and a compact filmstrip.",
  },
  {
    title: "Open protected files",
    description: "Use an in-browser password prompt to unlock a protected PDF and keep working.",
  },
  {
    title: "Reduce a PDF",
    description: "Losslessly compress an untouched, single uploaded PDF in your browser.",
  },
  {
    title: "Take pages with you",
    description: "Export selected or active pages as PNG images in a local ZIP archive.",
  },
];
---

<MarketingLayout
  title="Features — Interleaf"
  description="A local workspace for creating PDFs from images, bringing PDF files together, arranging their pages, exporting images, opening protected documents, and compressing PDFs."
  currentPage="features"
>
  <MarketingHero titleId="features-title">
    <h1 slot="primary" id="features-title" class="marketing-hero-title">
      Make the<br /><span>document ready.</span>
    </h1>

    <div slot="secondary" class="hero-copy">
      <p>
        Interleaf is a local workspace for the work that happens before a PDF is ready to share.
        Start with PNG/JPEG images or PDFs, shape their pages, export images, open protected documents, and
        compress PDFs in the browser.
      </p>
      <a class="marketing-hero-action" href={`${base}app`}>
        Open editor <span aria-hidden="true"><ArrowIcon /></span>
      </a>
    </div>
  </MarketingHero>

  <section class="capability-section" aria-labelledby="capability-title">
    <div class="marketing-container">
      <div class="section-intro">
        <p class="section-index">The work in between</p>
        <h2 id="capability-title">A few careful steps before the file goes out.</h2>
      </div>

      <div class="capability-list">
        {
          capabilities.map((capability) => (
            <article class="capability">
              <span class="capability-marker" aria-hidden="true"></span>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="local-note marketing-container" aria-label="Local processing">
    <span class="local-note-marker" aria-hidden="true"></span>
    <p>
      <strong>Your files stay with you.</strong> Interleaf processes documents in your browser.
      Nothing is uploaded.
    </p>
  </section>
</MarketingLayout>

<style>
  a:focus-visible {
    outline: 2px solid var(--marketing-accent);
    outline-offset: 4px;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1 span {
    color: var(--marketing-accent);
  }

  .hero-copy {
    max-width: 26rem;
  }

  .hero-copy > p {
    color: var(--marketing-muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .capability-section {
    padding-block: clamp(3.75rem, 8vw, 6.5rem);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(9rem, 0.5fr) minmax(0, 1.5fr);
    gap: 2rem;
    align-items: start;
  }

  .section-index {
    padding-top: 0.55rem;
    color: var(--marketing-muted);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 34rem;
    font-size: clamp(2rem, 4.3vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .capability-list {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--marketing-ink);
  }

  .capability {
    display: grid;
    grid-template-columns: 1rem minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--marketing-rule);
  }

  .capability:last-child {
    border-bottom-color: var(--marketing-ink);
  }

  .capability-marker,
  .local-note-marker {
    display: block;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--marketing-accent);
  }

  h3 {
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .capability p {
    max-width: 32rem;
    color: var(--marketing-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .local-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
    padding-block: 1.25rem;
    border-top: 1px solid var(--marketing-rule);
    color: var(--marketing-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .local-note strong {
    color: var(--marketing-ink);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .section-intro {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-copy {
      max-width: 30rem;
    }

    .capability {
      grid-template-columns: 1rem minmax(0, 1fr);
      gap: 0.85rem 1rem;
      padding-block: 1.35rem;
    }

    .capability p {
      grid-column: 2;
    }

    .local-note {
      align-items: flex-start;
    }
  }

</style>
