---
import MarketingLayout from "../components/marketing/MarketingLayout.astro";
import MarketingHero from "../components/marketing/MarketingHero.astro";

const capabilities = [
  {
    title: "Bring a document together",
    description:
      "Open PDFs and PNG or JPEG images in the same workspace. Images become PDF pages. Add more files later, or remove a source file and its pages.",
  },
  {
    title: "Shape the pages",
    description:
      "Reorder pages with drag and drop, rotate them in 90-degree steps, and mark the ones you no longer need. Duplicate a page to rotate, mark, or move each copy on its own.",
  },
  {
    title: "Review every page",
    description:
      "Switch between Pages to organize and Document to read. Move through pages with previous and next controls, or use the filmstrip. Zoom up to 4 times the fitted size.",
  },
  {
    title: "Undo and redo",
    description:
      "Undo or redo up to 32 changes in the current session, including page, source, text, checkmark, and field changes. History keeps up to 48 MiB of inactive source files.",
  },
  {
    title: "Add text",
    description:
      "Add one line of printable basic Latin text in Document view, using Helvetica. Drag, rotate, edit, or delete it.",
  },
  {
    title: "Fill supported form fields",
    description:
      "Fill embedded, unencrypted, single-line PDF text fields with basic Latin answers, using Helvetica. Other field types stay read-only.",
  },
  {
    title: "Mark flat forms",
    description:
      "Add checkmarks to flat or scanned forms in Document view. Move, resize, rotate, or delete each one.",
  },
  {
    title: "Open protected files",
    description:
      "An in-browser prompt asks for the password. Enter it to unlock a protected PDF and keep working.",
  },
  {
    title: "Reduce a PDF",
    description:
      "Losslessly compress one untouched PDF in your browser. Compression is available before page edits.",
  },
  {
    title: "Take pages with you",
    description:
      "Extract selected pages into a new PDF. You can also export selected pages, or every exportable page, as PNG images in a ZIP archive. Saved text, checkmarks, and answers appear in both.",
  },
];
---

<MarketingLayout
  title="Features — Interleaf"
  description="What Interleaf does in your browser: bring PDFs and PNG or JPEG images together, shape their pages, and export the result."
  currentPage="features"
>
  <MarketingHero
    titleId="features-title"
    title="Everything before the export."
    lede="Interleaf is a local workspace that runs entirely in your browser. The list below covers what it does today."
  />

  <section class="marketing-section" aria-label="Features">
    <div class="marketing-container">
      <ul class="marketing-rows">
        {
          capabilities.map((capability) => (
            <li class="marketing-row">
              <span class="marketing-row-dot" aria-hidden="true"></span>
              <h2 class="marketing-row-title">{capability.title}</h2>
              <p class="marketing-row-body">{capability.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</MarketingLayout>
