---
import FeatureVignette from "../components/marketing/FeatureVignette.astro";
import MarketingLayout from "../components/marketing/MarketingLayout.astro";
import MarketingHero from "../components/marketing/MarketingHero.astro";

const groups: {
  label: string;
  capabilities: {
    title: string;
    description: string;
    icon: string;
    vignette?: "text" | "field" | "check";
  }[];
}[] = [
  {
    label: "Assemble",
    capabilities: [
      {
        icon: '<path d="M15 2h-4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8" /><path d="M16.706 2.706A2.4 2.4 0 0 0 15 2v5a1 1 0 0 0 1 1h5a2.4 2.4 0 0 0-.706-1.706z" /><path d="M5 7a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h8a2 2 0 0 0 1.732-1" />',
        title: "Combine files",
        description: "Open PDFs and images together, then add or remove files later.",
      },
      {
        icon: '<circle cx="12" cy="16" r="1" /><rect x="3" y="10" width="18" height="12" rx="2" /><path d="M7 10V7a5 5 0 0 1 10 0v3" />',
        title: "Unlock protected PDFs",
        description: "Enter the password to open a protected PDF and keep working.",
      },
    ],
  },
  {
    label: "Arrange",
    capabilities: [
      {
        icon: '<path d="m3 16 4 4 4-4" /><path d="M7 20V4" /><path d="m21 8-4-4-4 4" /><path d="M17 4v16" />',
        title: "Arrange pages",
        description: "Drag to reorder, rotate, duplicate, or mark pages for deletion.",
      },
      {
        icon: '<path d="M12 5v16" /><path d="M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z" />',
        title: "Review pages",
        description: "Organize in Pages view, then read page by page in Document view.",
      },
      {
        icon: '<path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" />',
        title: "Undo and redo",
        description: "Step back through your last 32 changes, and forward again.",
      },
    ],
  },
  {
    label: "Annotate",
    capabilities: [
      {
        icon: '<path d="M12 4v16" /><path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2" /><path d="M9 20h6" />',
        title: "Add text",
        description: "Type a line of text on any page, then drag or rotate it.",
        vignette: "text",
      },
      {
        icon: '<path d="M12 20h-1a2 2 0 0 1-2-2 2 2 0 0 1-2 2H6" /><path d="M13 8h7a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-7" /><path d="M5 16H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h1" /><path d="M6 4h1a2 2 0 0 1 2 2 2 2 0 0 1 2-2h1" /><path d="M9 6v12" />',
        title: "Fill form fields",
        description: "Type into the single-line text fields of a PDF form.",
        vignette: "field",
      },
      {
        icon: '<rect width="18" height="18" x="3" y="3" rx="2" /><path d="m16 9-5.5 5.5L8 12" />',
        title: "Add checkmarks",
        description: "Tick boxes on flat or scanned forms, then resize them.",
        vignette: "check",
      },
    ],
  },
  {
    label: "Export",
    capabilities: [
      {
        icon: '<path d="M12 15V3" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" />',
        title: "Export pages",
        description: "Download a PDF, extract selected pages, or export PNG images.",
      },
      {
        icon: '<path d="m14 10 7-7" /><path d="M20 10h-6V4" /><path d="m3 21 7-7" /><path d="M4 14h6v6" />',
        title: "Compress",
        description: "Shrink a single PDF without losing quality, before you edit it.",
      },
    ],
  },
];
---

<MarketingLayout
  title="Features | Interleaf"
  description="Combine PDFs and images, arrange pages, add text and checkmarks, fill form fields, and export a PDF or PNG images."
  currentPage="features"
>
  <MarketingHero
    titleId="features-title"
    title="Everything before the export."
    lede="Open PDFs and images, shape the pages, and export what you need."
  />

  <div class="marketing-section">
    <div class="marketing-container">
      {
        groups.map((group) => (
          <section class="feature-group" aria-labelledby={`features-${group.label.toLowerCase()}`}>
            <h2 id={`features-${group.label.toLowerCase()}`} class="marketing-subhead">
              {group.label}
            </h2>
            <div class:list={["feature-grid", group.capabilities.length === 2 && "is-pair"]}>
              {group.capabilities.map((capability) => (
                <article class="feature-card marketing-card">
                  <span class="feature-icon">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={capability.icon}
                    />
                  </span>
                  <h3>{capability.title}</h3>
                  <p>{capability.description}</p>
                  {capability.vignette && (
                    <div class="feature-vignette">
                      <FeatureVignette kind={capability.vignette} />
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</MarketingLayout>

<style>
  @reference "../styles/global.css";

  .feature-group + .feature-group {
    margin-top: 3rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .feature-icon {
    display: grid;
    color: var(--color-accent);
  }

  .feature-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .feature-card h3 {
    @apply text-ui-lg;
    font-weight: 650;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-fg);
  }

  .feature-card p {
    @apply text-body-sm;
    margin: 0;
    color: var(--color-fg-muted);
  }

  .feature-vignette {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (width < 48rem) {
    .feature-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      padding: 1.25rem;
    }

    .feature-card p,
    .feature-vignette {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 48rem) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .feature-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .feature-grid.is-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
