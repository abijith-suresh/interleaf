---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const route = (path: string) => `${base}${path}`;

const operations = [
  {
    num: "01",
    title: "Merge",
    text: "Combine multiple PDFs into one working set.",
  },
  {
    num: "02",
    title: "Extract",
    text: "Save selected pages as a new PDF.",
  },
  {
    num: "03",
    title: "Reorder",
    text: "Move pages with drag and drop.",
  },
  {
    num: "04",
    title: "Rotate",
    text: "Turn one page or a selection in 90-degree steps.",
  },
  {
    num: "05",
    title: "Delete",
    text: "Mark pages for removal before export.",
  },
  {
    num: "06",
    title: "Unlock",
    text: "Open a password-protected PDF with an in-browser prompt.",
  },
];

const experiments = ["1", "2", "3", "4", "5"];
---

<Layout
  title="Interleaf - Paper workbench"
  description="A paper workbench for editing PDF pages in your browser. No uploads, no server processing."
>
  <div class="paper-workbench">
    <header class="site-header">
      <div class="brand-lockup">
        <a class="brand" href={base} aria-label="Interleaf home">Interleaf</a>
        <span class="brand-divider" aria-hidden="true"></span>
        <span class="brand-context">Paper workbench</span>
      </div>

      <a class="home-link" href={base}>
        <span aria-hidden="true">←</span>
        Back to home
      </a>

      <nav class="experiment-nav" aria-label="Landing page experiments">
        <span class="experiment-label">Explore directions</span>
        <ol class="experiment-list">
          {
            experiments.map((experiment) => (
              <li>
                <a
                  href={route(experiment)}
                  aria-label={`Open landing page experiment ${experiment}`}
                  aria-current={experiment === "3" ? "page" : undefined}
                  class:list={{ "is-current": experiment === "3" }}
                >
                  {experiment}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="hero-serial" aria-hidden="true">
            <span>Landing study</span>
            <span class="serial-rule"></span>
            <span>03 / 05</span>
          </div>

          <h1 id="hero-title" class="hero-title">
            Paper<br /><span class="hero-title-accent">workbench.</span>
          </h1>

          <p class="hero-lede">
            Open a local PDF, put its pages in order, and export the file when the stack is right.
          </p>

          <div class="hero-action-row">
            <a class="primary-action" href={route("app")}>
              Open Editor
              <span class="action-arrow" aria-hidden="true">↗</span>
            </a>
            <span class="action-note">Six page tools<br />in one browser tab.</span>
          </div>
        </div>

        <figure class="bench-figure" aria-labelledby="bench-caption">
          <div class="paper-stage" aria-hidden="true">
            <div class="stage-cross stage-cross--top"></div>
            <div class="stage-cross stage-cross--bottom"></div>
            <div class="paper-sheet paper-sheet--back">
              <span class="back-label">PDF / 01</span>
            </div>
            <div class="paper-sheet paper-sheet--front">
              <div class="sheet-header">
                <span>Interleaf</span>
                <span>Local / page set</span>
              </div>
              <div class="sheet-rule"></div>
              <div class="sheet-body">
                <span class="sheet-number">06</span>
                <div class="sheet-copy">
                  <span class="sheet-copy-label">Tools at hand</span>
                  <span class="sheet-copy-line"></span>
                  <span class="sheet-copy-line sheet-copy-line--short"></span>
                  <span class="sheet-copy-line"></span>
                </div>
              </div>
              <div class="sheet-footer">
                <span>Move / mark / export</span>
                <span class="sheet-marker"></span>
              </div>
            </div>
          </div>
          <figcaption id="bench-caption" class="bench-caption">
            <span class="caption-index">00</span>
            <span>A clear desk for the pages in front of you.</span>
          </figcaption>
        </figure>
      </section>

      <div class="privacy-band" role="note">
        <span class="privacy-marker" aria-hidden="true"></span>
        <p>
          <strong>Browser only.</strong> PDFs are processed in your browser and never leave your
          device.
        </p>
        <span class="privacy-end" aria-hidden="true">/ local</span>
      </div>

      <section class="content-frame operations-section" id="operations" aria-labelledby="operations-title">
        <div class="section-heading">
          <p class="section-index"><span class="section-marker"></span>01 / tools</p>
          <div>
            <h2 id="operations-title">Six ways to put a PDF in order.</h2>
            <p class="section-lede">
              The editor keeps the useful actions close to the page set. Pick a file, make the
              change, and keep moving.
            </p>
          </div>
        </div>

        <div class="operation-grid">
          {
            operations.map((operation) => (
              <article class="operation-card">
                <div class="operation-topline">
                  <span class="operation-number">{operation.num}</span>
                  <span class="operation-marker" aria-hidden="true"></span>
                </div>
                <h3>{operation.title}</h3>
                <p>{operation.text}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="content-frame work-order-section" aria-labelledby="work-order-title">
        <div class="work-order-panel">
          <div class="work-order-heading">
            <p class="section-index section-index--inverse">
              <span class="section-marker"></span>02 / work order
            </p>
            <h2 id="work-order-title">Start with the file.<br />Leave with the file.</h2>
            <p>
              Nothing to configure before the work begins. The document opens here, the page set
              changes here, and the finished PDF comes back to you.
            </p>
          </div>

          <ol class="work-order-list">
            <li>
              <span class="work-order-number">01</span>
              <span class="work-order-step">Open a local PDF</span>
              <span class="work-order-mark" aria-hidden="true">↘</span>
            </li>
            <li>
              <span class="work-order-number">02</span>
              <span class="work-order-step">Shape the page set</span>
              <span class="work-order-mark" aria-hidden="true">↘</span>
            </li>
            <li>
              <span class="work-order-number">03</span>
              <span class="work-order-step">Export the result</span>
              <span class="work-order-mark" aria-hidden="true">↗</span>
            </li>
          </ol>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand-line">
        <a class="footer-brand" href={base}>Interleaf</a>
        <span>Paper workbench / 03</span>
      </div>
      <nav class="footer-nav" aria-label="Product information">
        <a href={route("features")}>Features</a>
        <a href={route("about")}>About</a>
        <a href={route("faq")}>FAQ</a>
      </nav>
      <p class="footer-note">PDF work stays in your browser.</p>
    </footer>
  </div>
</Layout>

<style>
  .paper-workbench {
    --paper: #f4f0e6;
    --paper-light: #fffdf7;
    --ink: #171717;
    --ink-soft: #5b5851;
    --line: rgba(23, 23, 23, 0.22);
    --red: #f31d29;
    --gutter: clamp(1.25rem, 4.2vw, 5rem);
    min-height: 100vh;
    overflow: hidden;
    background-color: var(--paper);
    background-image:
      linear-gradient(rgba(23, 23, 23, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 23, 23, 0.035) 1px, transparent 1px);
    background-size: 4rem 4rem;
    color: var(--ink);
    font-family: var(--font-body);
  }

  .paper-workbench *,
  .paper-workbench *::before,
  .paper-workbench *::after {
    box-sizing: border-box;
  }

  .site-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 4rem);
    width: min(100%, 96rem);
    margin: 0 auto;
    padding: 1.1rem var(--gutter);
    border-bottom: 2px solid var(--ink);
  }

  .brand-lockup,
  .home-link,
  .experiment-nav,
  .experiment-list,
  .hero-serial,
  .hero-action-row,
  .operation-topline,
  .sheet-header,
  .sheet-footer,
  .footer-brand-line,
  .footer-nav {
    display: flex;
    align-items: center;
  }

  .brand-lockup {
    min-width: 0;
    gap: 0.85rem;
  }

  .brand,
  .footer-brand {
    color: var(--ink);
    font-family: var(--font-display);
    line-height: 1;
    text-decoration: none;
  }

  .brand {
    font-size: clamp(1.9rem, 3vw, 2.45rem);
    letter-spacing: 0.02em;
  }

  .brand-divider {
    width: 1px;
    height: 1.6rem;
    background: var(--ink);
    opacity: 0.35;
  }

  .brand-context,
  .experiment-label,
  .home-link,
  .footer-brand-line span,
  .footer-nav a,
  .footer-note {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .brand-context {
    overflow: hidden;
    color: var(--ink-soft);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-link {
    min-height: 2.75rem;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .home-link span {
    color: var(--red);
    font-size: 1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .home-link:hover span {
    transform: translateX(-0.2rem);
  }

  .experiment-nav {
    gap: 0.8rem;
  }

  .experiment-label {
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .experiment-list {
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experiment-list a {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .experiment-list a:hover,
  .experiment-list a.is-current {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }

  .experiment-list a:hover {
    transform: translateY(-0.15rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: center;
    width: min(100%, 96rem);
    margin: 0 auto;
    padding: clamp(5rem, 11vw, 10rem) var(--gutter) clamp(4rem, 9vw, 7rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-serial {
    gap: 0.7rem;
    margin-bottom: clamp(1.75rem, 4vw, 3.5rem);
    color: var(--ink-soft);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .serial-rule {
    display: block;
    width: 2.5rem;
    height: 0.25rem;
    background: var(--red);
  }

  .hero-title,
  .section-heading h2,
  .work-order-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 0.82;
    text-wrap: balance;
  }

  .hero-title {
    max-width: 10ch;
    font-size: clamp(5.6rem, 13vw, 12.5rem);
  }

  .hero-title-accent {
    position: relative;
    display: inline-block;
    color: var(--red);
  }

  .hero-title-accent::after {
    position: absolute;
    right: 0.05em;
    bottom: -0.06em;
    width: 2.2em;
    height: 0.08em;
    background: var(--ink);
    content: "";
    transform: rotate(-1.5deg);
  }

  .hero-lede {
    max-width: 27rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    border-left: 0.35rem solid var(--red);
    padding-left: 1.1rem;
    color: var(--ink-soft);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 400;
    line-height: 1.35;
  }

  .hero-action-row {
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.4rem;
  }

  .primary-action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 1.75rem;
    padding: 0.9rem 1.15rem 0.9rem 1.35rem;
    background: var(--ink);
    box-shadow: 0.4rem 0.4rem 0 var(--red);
    color: var(--paper-light);
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .primary-action:hover {
    background: var(--red);
    box-shadow: 0.4rem 0.4rem 0 var(--ink);
    transform: translate(-0.1rem, -0.1rem);
  }

  .action-arrow {
    color: var(--red);
    font-size: 1.25rem;
    line-height: 1;
    transition: color 180ms ease, transform 180ms ease;
  }

  .primary-action:hover .action-arrow {
    color: var(--ink);
    transform: translate(0.15rem, -0.15rem);
  }

  .action-note {
    color: var(--ink-soft);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .bench-figure {
    width: min(100%, 33rem);
    margin: 0 auto;
  }

  .paper-stage {
    position: relative;
    aspect-ratio: 0.92;
    isolation: isolate;
    min-height: 25rem;
    border: 1px solid var(--line);
    background: rgba(255, 253, 247, 0.22);
  }

  .paper-stage::before,
  .paper-stage::after {
    position: absolute;
    z-index: -1;
    background: var(--red);
    content: "";
  }

  .paper-stage::before {
    top: 10%;
    right: -1rem;
    width: 1rem;
    height: 40%;
  }

  .paper-stage::after {
    bottom: 7%;
    left: -0.65rem;
    width: 0.65rem;
    height: 26%;
  }

  .stage-cross {
    position: absolute;
    width: 1.2rem;
    height: 1.2rem;
  }

  .stage-cross::before,
  .stage-cross::after {
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--ink);
    content: "";
    transform: translate(-50%, -50%);
  }

  .stage-cross::before {
    width: 100%;
    height: 1px;
  }

  .stage-cross::after {
    width: 1px;
    height: 100%;
  }

  .stage-cross--top {
    top: 1.25rem;
    right: 1.25rem;
  }

  .stage-cross--bottom {
    bottom: 1.25rem;
    left: 1.25rem;
  }

  .paper-sheet {
    position: absolute;
    border: 2px solid var(--ink);
    background: var(--paper-light);
  }

  .paper-sheet--back {
    top: 14%;
    right: 9%;
    bottom: 10%;
    left: 12%;
    box-shadow: 0.65rem 0.65rem 0 var(--ink);
    transform: rotate(3deg);
  }

  .back-label {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .paper-sheet--front {
    top: 10%;
    right: 12%;
    bottom: 14%;
    left: 8%;
    display: flex;
    flex-direction: column;
    padding: clamp(1.15rem, 3vw, 2rem);
  }

  .sheet-header,
  .sheet-footer {
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-soft);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .sheet-header span:last-child {
    text-align: right;
  }

  .sheet-rule {
    width: 100%;
    height: 2px;
    margin-top: 1.25rem;
    background: var(--ink);
  }

  .sheet-body {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(6rem, 1.2fr);
    flex: 1;
    align-items: center;
    gap: 1rem;
  }

  .sheet-number {
    color: var(--red);
    font-family: var(--font-display);
    font-size: clamp(7rem, 18vw, 11rem);
    line-height: 0.7;
  }

  .sheet-copy {
    display: grid;
    gap: 0.7rem;
  }

  .sheet-copy-label {
    margin-bottom: 0.5rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sheet-copy-line {
    display: block;
    width: 100%;
    height: 0.28rem;
    background: var(--ink);
    opacity: 0.82;
  }

  .sheet-copy-line--short {
    width: 62%;
    background: var(--red);
  }

  .sheet-footer {
    align-items: flex-end;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .sheet-marker {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--red);
  }

  .bench-caption {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 0.85rem;
    color: var(--ink-soft);
    font-size: 0.74rem;
    line-height: 1.45;
  }

  .caption-index {
    color: var(--red);
    font-weight: 600;
  }

  .privacy-band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    width: min(100%, 96rem);
    margin: 0 auto;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: 1rem var(--gutter);
    background: rgba(255, 253, 247, 0.62);
  }

  .privacy-marker {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--red);
  }

  .privacy-band p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.83rem;
    line-height: 1.45;
  }

  .privacy-band strong {
    color: var(--ink);
    font-weight: 600;
  }

  .privacy-end {
    color: var(--ink-soft);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .content-frame {
    width: min(100%, 96rem);
    margin: 0 auto;
    padding-right: var(--gutter);
    padding-left: var(--gutter);
  }

  .operations-section {
    padding-top: clamp(5rem, 10vw, 9rem);
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(9rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .section-index {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-marker {
    display: inline-block;
    width: 2rem;
    height: 0.25rem;
    background: var(--red);
    flex-shrink: 0;
  }

  .section-heading h2 {
    max-width: 17ch;
    font-size: clamp(3.5rem, 7vw, 6.75rem);
  }

  .section-lede {
    max-width: 32rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.6;
  }

  .operation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 2px solid var(--ink);
    background: var(--ink);
  }

  .operation-card {
    position: relative;
    display: flex;
    min-height: 15rem;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--paper-light);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .operation-card::before {
    position: absolute;
    top: 0;
    right: 0;
    width: 0.45rem;
    height: 2.6rem;
    background: var(--red);
    content: "";
  }

  .operation-card:hover {
    background: var(--red);
  }

  .operation-card:hover::before {
    background: var(--ink);
  }

  .operation-topline {
    justify-content: space-between;
  }

  .operation-number {
    color: var(--ink-soft);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .operation-marker {
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid var(--red);
  }

  .operation-card h3 {
    margin: auto 0 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 400;
    line-height: 0.9;
  }

  .operation-card p {
    max-width: 18rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .operation-card:hover p,
  .operation-card:hover .operation-number {
    color: var(--ink);
  }

  .work-order-section {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .work-order-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    border: 2px solid var(--ink);
    padding: clamp(1.5rem, 5vw, 4rem);
    background: var(--ink);
    color: var(--paper-light);
  }

  .work-order-heading h2 {
    margin-top: 2rem;
