---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { socialPreviewFilename, socialPreviewSize } from "../utils/social-preview";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** The face the page paints with: Inter on marketing pages, Work Sans in the editor. */
  font?: "inter" | "work-sans";
}

const { title, description, ogImage, font = "work-sans" } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const slug = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "index";
const resolvedOgImage = ogImage ?? `${siteOrigin}${base}og/${socialPreviewFilename(slug)}`;
const preloadedFontFiles =
  font === "inter"
    ? ["inter-latin-opsz-normal.woff2"]
    : [300, 400, 500, 600].map((weight) => `work-sans-latin-${weight}-normal.woff2`);
---

<html lang="en" data-font={font}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 96x96" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    {
      preloadedFontFiles.map((file) => (
        <link
          rel="preload"
          href={`${base}fonts/${file}`}
          as="font"
          type="font/woff2"
          crossorigin
        />
      ))
    }
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Interleaf" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content={String(socialPreviewSize.width)} />
    <meta property="og:image:height" content={String(socialPreviewSize.height)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />
    <slot name="head" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>

<script>
  // Faces use font-display: optional, so a face that is not ready when a page
  // first paints is skipped for the life of the document. Client-side
  // navigation keeps the document, so load the next page's face before the
  // swap. The cap keeps a slow font from holding the navigation.
  const FAMILIES: Record<string, string> = { inter: "Inter Variable", "work-sans": "Work Sans" };

  document.addEventListener("astro:before-preparation", (event) => {
    const loadPage = event.loader;
    event.loader = async () => {
      await loadPage();
      const family = FAMILIES[event.newDocument.documentElement.dataset.font ?? ""];
      const faces = [...document.fonts].filter(
        (face) => face.family.replace(/"/g, "") === family && face.status !== "loaded"
      );
      if (faces.length === 0) return;
      await Promise.race([
        Promise.allSettled(faces.map((face) => face.load())),
        new Promise((resolve) => setTimeout(resolve, 1000)),
      ]);
    };
  });
</script>
