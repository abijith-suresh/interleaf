---
const { label, title } = Astro.props;
---

<section class="px-6 md:px-16 lg:px-24 pt-24 pb-16 border-b border-border">
  <div class="max-w-7xl mx-auto">
    <p class="section-heading animate-on-scroll">{label}</p>
    <h1 class="page-heading animate-on-scroll stagger-1">{title}</h1>
  </div>
</section>
