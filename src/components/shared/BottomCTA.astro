---
const { buttonText, buttonHref } = Astro.props;
---

<section class="cta-section marketing-cta">
  <div class="cta-section-inner animate-on-scroll">
    <div class="cta-copy">
      <h2 class="cta-heading"><slot name="heading" /></h2>
    </div>
    <div class="cta-action">
      <a
        href={buttonHref}
        class="btn-primary press-feedback"
        target={buttonHref.startsWith("http") ? "_blank" : undefined}
        rel={buttonHref.startsWith("http") ? "noopener noreferrer" : undefined}
      >
        {buttonText}
      </a>
    </div>
  </div>
</section>
