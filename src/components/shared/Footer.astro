---
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer marketing-footer section-padding" transition:animate="fade">
  <div class="site-footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <a href={base} class="footer-brand-link" aria-label="Interleaf home">interleaf</a>
        <p>PDF tools that run in your browser.</p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <a href={`${base}about`} class="footer-link">About</a>
        <a
          href="https://github.com/abijith-suresh/interleaf"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link">GitHub</a
        >
        <a href={`${base}features`} class="footer-link">Features</a>
        <a href={`${base}app`} class="footer-link">Open editor</a>
        <a href={`${base}faq`} class="footer-link">FAQ</a>
        <a href={`${base}privacy`} class="footer-link">Privacy</a>
        <a href={`${base}terms`} class="footer-link">Terms</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span>&copy; 2026 Interleaf</span>
      <span>Your files stay on your device.</span>
    </div>
  </div>
</footer>
