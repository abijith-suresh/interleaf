---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Features", href: `${base}features`, key: "features" },
  { label: "About", href: `${base}about`, key: "about" },
  { label: "FAQ", href: `${base}faq`, key: "faq" },
];
---

<nav class="section-padding border-b border-border" transition:persist>
  <div class="h-14 flex items-center justify-between max-w-7xl mx-auto">
    <a href={base} class="font-display text-2xl text-primary no-underline tracking-wide"
      >Interleaf</a
    >
    <div class="flex items-center gap-6 md:gap-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "hidden sm:inline text-nano font-medium text-body uppercase tracking-label no-underline transition-colors hover:text-primary link-slide",
              currentPage === link.key && "text-primary border-b-2 border-primary pb-0.5",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href={`${base}app`} class="btn-primary text-nano px-5 py-2 press-feedback">
        Open Editor
      </a>
    </div>
  </div>
</nav>
