---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Features", href: `${base}features`, key: "features" },
  { label: "About", href: `${base}about`, key: "about" },
  { label: "FAQ", href: `${base}faq`, key: "faq" },
];
---

<nav class="site-nav marketing-nav section-padding" aria-label="Main navigation">
  <div class="site-nav-inner">
    <a href={base} class="site-brand" aria-label="Interleaf home">interleaf</a>

    <div class="nav-actions">
      <div class="desktop-nav">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={["nav-link", currentPage === link.key && "is-current"]}
              aria-current={currentPage === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <details class="mobile-nav">
        <summary class="mobile-nav-trigger interactive-focus">Menu</summary>
        <div class="mobile-nav-panel">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={["mobile-nav-link", currentPage === link.key && "is-current"]}
                aria-current={currentPage === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </details>

      <a href={`${base}app`} class="btn-primary nav-editor-link press-feedback">Open editor</a>
    </div>
  </div>
</nav>
