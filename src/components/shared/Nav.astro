---
import Wordmark from "./Wordmark";

interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Features", href: `${base}features`, key: "features" },
  { label: "FAQ", href: `${base}faq`, key: "faq" },
];
---

<nav class="site-nav marketing-nav" aria-label="Main navigation" transition:animate="none">
  <div class="site-nav-inner">
    <a href={base} class="site-brand" aria-label="Interleaf home"><Wordmark /></a>

    <div class="nav-actions">
      <div class="desktop-nav">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[
                "marketing-link",
                currentPage === link.key && "is-current",
              ]}
              aria-current={currentPage === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <a href={`${base}app`} class="marketing-button marketing-button-compact">Open editor</a>

      {/* Below 48rem the page links move into a dropdown under this button. */}
      <details class="mobile-nav">
        <summary class="mobile-nav-trigger">
          <span class="sr-only">Menu</span>
          <svg class="mobile-nav-icon mobile-nav-icon-menu" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="2.25"></path>
          </svg>
          <svg class="mobile-nav-icon mobile-nav-icon-close" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6 6l12 12M18 6 6 18"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="2.25"></path>
          </svg>
        </summary>
        <div class="mobile-nav-panel">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={["mobile-nav-link", currentPage === link.key && "is-current"]}
                aria-current={currentPage === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
          <hr class="mobile-nav-divider" />
          <a href={`${base}app`} class="marketing-button">Open editor</a>
        </div>
      </details>
    </div>
  </div>
</nav>

<script>
  const OPEN_MENU = "details.mobile-nav[open]";

  function closeMenus(returnFocus = false) {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(OPEN_MENU)) {
      menu.open = false;
      if (returnFocus) menu.querySelector<HTMLElement>("summary")?.focus();
    }
  }

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !event.defaultPrevented && document.querySelector(OPEN_MENU)) {
      closeMenus(true);
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>(OPEN_MENU)) {
      // Outside click, or a link in the panel (a same-page link never swaps the page).
      if (!menu.contains(target) || target.closest(".mobile-nav-panel a")) menu.open = false;
    }
  });

  document.addEventListener("astro:after-swap", () => closeMenus());
</script>
