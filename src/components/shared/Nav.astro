---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Features", href: `${base}features`, key: "features" },
  { label: "About", href: `${base}about`, key: "about" },
  { label: "FAQ", href: `${base}faq`, key: "faq" },
];
---

<nav class="site-nav section-padding border-b border-border" transition:persist>
  <div class="site-nav-inner h-16 flex items-center justify-between max-w-7xl mx-auto">
    <a href={base} class="font-display text-2xl text-primary no-underline tracking-wide"
      >Interleaf</a
    >
    <div class="nav-actions flex items-center gap-3 sm:gap-6 md:gap-8">
      <div class="hidden sm:flex items-center gap-6 md:gap-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "hidden sm:inline text-nano font-medium text-body uppercase tracking-label no-underline transition-colors hover:text-primary link-slide",
              currentPage === link.key && "text-primary border-b-2 border-primary pb-0.5",
            ]}
            aria-current={currentPage === link.key ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      </div>

      <details class="mobile-nav sm:hidden">
        <summary class="mobile-nav-trigger interactive-focus">Menu</summary>
        <div class="mobile-nav-panel">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "mobile-nav-link link-slide",
                  currentPage === link.key && "is-current",
                ]}
                aria-current={currentPage === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </details>

      <a href={`${base}app`} class="btn-primary nav-editor-link text-nano press-feedback">
        Open Editor
      </a>
    </div>
  </div>
</nav>
