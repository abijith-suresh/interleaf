---
import HeroDemo from "./HeroDemo.astro";
import MarketingHero from "./MarketingHero.astro";

const base = import.meta.env.BASE_URL;

const steps = [
  {
    title: "Bring files together",
    body: "Open PDFs and PNG or JPEG images at once, or add more as you go. Images become PDF pages.",
  },
  {
    title: "Put pages in order",
    body: "Drag to reorder, rotate in 90° steps, duplicate, or mark pages for deletion. In Document view, add text and checkmarks or fill supported form fields.",
  },
  {
    title: "Download one PDF",
    body: "Download the finished PDF, extract selected pages into a new one, or export pages as PNG images.",
  },
];
---

<MarketingHero variant="home" titleId="landing-title">
  <div slot="primary" class="landing-hero-copy">
    <h1 id="landing-title" class="marketing-hero-title landing-hero-title">
      Make the<br />
      document ready.
    </h1>
    <p class="marketing-lede">
      Combine PDFs and images, put every page in order, and download one PDF.
    </p>
    <div class="landing-hero-action">
      <a class="marketing-button" href={base + "app"}>Open editor</a>
    </div>
  </div>

  <HeroDemo slot="secondary" />
</MarketingHero>

<section class="marketing-section" aria-labelledby="workflow-title">
  <div class="marketing-container">
    <div class="marketing-section-head">
      <h2 id="workflow-title" class="marketing-section-title">
        From a stack of files to one finished PDF.
      </h2>
    </div>

    <ol class="marketing-rows landing-steps">
      {
        steps.map((step, index) => (
          <li class="marketing-row">
            <span class="marketing-row-marker" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="marketing-row-title">{step.title}</h3>
            <p class="marketing-row-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .landing-hero-copy {
    max-width: 38rem;
  }

  .landing-hero-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2.5rem;
  }

  /* The steps sit under an ink ruler, measured like the mat. */
  .landing-steps {
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  .landing-steps::before {
    display: block;
    height: 1.5rem;
    border-bottom: 1px solid var(--color-fg);
    background-image:
      linear-gradient(to right, var(--color-fg) 1px, transparent 1px),
      linear-gradient(to right, color-mix(in srgb, var(--color-fg) 50%, transparent) 1px, transparent 1px),
      linear-gradient(to right, color-mix(in srgb, var(--color-fg) 30%, transparent) 1px, transparent 1px);
    background-position: 0 100%;
    background-repeat: repeat-x;
    background-size:
      60px 12px,
      12px 7px,
      6px 4px;
    content: "";
  }

  .landing-steps .marketing-row {
    padding-inline: 0;
  }

  @media (min-width: 64rem) {
    .landing-steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 3rem;
    }

    .landing-steps::before {
      grid-column: 1 / -1;
    }

    .landing-steps .marketing-row {
      display: block;
      padding-block: 1.5rem 0;
    }

    .landing-steps .marketing-row + .marketing-row {
      border-top: 0;
    }

    .landing-steps .marketing-row-title {
      margin-top: 1.25rem;
    }

    .landing-steps .marketing-row-body {
      margin-top: 0.75rem;
    }
  }
</style>
