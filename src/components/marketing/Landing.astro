---
import HeroDemo from "./HeroDemo.astro";
import MarketingHero from "./MarketingHero.astro";

const base = import.meta.env.BASE_URL;

const steps = [
  {
    title: "Bring files together",
    body: "Open PDFs and PNG or JPEG images at once, or add more as you go. Images become PDF pages.",
  },
  {
    title: "Put pages in order",
    body: "Drag to reorder, rotate in 90° steps, duplicate, or mark pages for deletion. In Document view, add text and checkmarks or fill supported form fields.",
  },
  {
    title: "Keep it on your device",
    body: "Every step runs in your browser. Nothing is uploaded, and there is no account to create.",
  },
];
---

<MarketingHero variant="home" titleId="landing-title">
  <div slot="primary" class="landing-hero-copy">
    <h1 id="landing-title" class="marketing-hero-title landing-hero-title">
      Make the<br />
      document ready.
    </h1>
    <p class="marketing-lede">
      Combine PDFs and images, put every page in order, and download one PDF. Your files never
      leave your device.
    </p>
    <div class="landing-hero-action">
      <a class="marketing-button" href={base + "app"}>Open editor</a>
      <p class="landing-hero-note">Runs in your browser. No uploads, no account.</p>
    </div>
  </div>

  <HeroDemo slot="secondary" />
</MarketingHero>

<section class="marketing-section" aria-labelledby="workflow-title">
  <div class="marketing-container">
    <div class="marketing-section-head">
      <h2 id="workflow-title" class="marketing-section-title">
        From a stack of files to one finished PDF.
      </h2>
    </div>

    <ol class="marketing-rows">
      {
        steps.map((step, index) => (
          <li class="marketing-row">
            <span class="marketing-row-marker" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="marketing-row-title">{step.title}</h3>
            <p class="marketing-row-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .landing-hero-copy {
    max-width: 38rem;
  }

  .landing-hero-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }

  .landing-hero-note {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: var(--text-body-sm);
    line-height: var(--text-body-sm--line-height);
    letter-spacing: var(--text-body-sm--letter-spacing);
  }
</style>
