---
import MarketingHero from "./MarketingHero.astro";

const base = import.meta.env.BASE_URL;

const steps = [
  {
    title: "Bring together",
    body: "Open PDFs and PNG or JPEG images in one place, and add more files as you work.",
  },
  {
    title: "Shape pages",
    body: "Reorder, rotate, and duplicate pages, mark pages for deletion, or extract a selection into a new PDF. Add text and checkmarks in Document view.",
  },
  {
    title: "Keep it local",
    body: "Everything runs in your browser. Nothing is uploaded.",
  },
];
---

<MarketingHero variant="home" titleId="landing-title">
  <div slot="primary" class="landing-hero-copy">
    <h1 id="landing-title" class="marketing-hero-title landing-hero-title">
      Make the<br />
      <span>document ready.</span>
    </h1>
    <p class="marketing-lede">
      Open PDFs and PNG or JPEG images together, review and shape their pages, and export the
      result. Your files never leave your device.
    </p>
    <a class="marketing-button" href={base + "app"}>Open editor</a>
  </div>

  <div slot="secondary" class="workspace-cue" aria-hidden="true">
    <div class="cue-top">
      <span class="cue-dot"></span>
      <span class="cue-rule"></span>
      <span class="cue-rule cue-rule-short"></span>
    </div>
    <div class="cue-field">
      <span class="sheet sheet-back"></span>
      <span class="sheet sheet-middle"></span>
      <span class="sheet sheet-front">
        <span class="sheet-heading"></span>
        <span class="sheet-line sheet-line-wide"></span>
        <span class="sheet-line"></span>
        <span class="sheet-line sheet-line-short"></span>
        <span class="sheet-line"></span>
      </span>
      <span class="sheet-marker"></span>
    </div>
    <div class="cue-bottom">
      <span class="cue-rule cue-rule-long"></span>
      <span class="cue-dot cue-dot-small"></span>
    </div>
  </div>
</MarketingHero>

<section class="marketing-section" aria-labelledby="workflow-title">
  <div class="marketing-container">
    <div class="marketing-section-head">
      <h2 id="workflow-title" class="marketing-section-title">
        The work between opening a file and sending it.
      </h2>
    </div>

    <ol class="marketing-rows">
      {
        steps.map((step, index) => (
          <li class="marketing-row">
            <span class="marketing-row-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="marketing-row-title">{step.title}</h3>
            <p class="marketing-row-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .landing-hero-copy {
    max-width: 38rem;
  }

  .landing-hero-title span {
    color: var(--marketing-accent);
  }

  .landing-hero-copy .marketing-button {
    margin-top: 1.75rem;
  }

  /* The workspace illustration. Its soft rule and field tints are its own. */
  .workspace-cue {
    --cue-line-soft: #ebe8e1;
    --cue-field: #f0eee8;
    width: min(100%, 25rem);
    aspect-ratio: 1.08;
    justify-self: end;
    overflow: hidden;
    border: 1px solid var(--marketing-rule);
    border-radius: 1.1rem;
    background: var(--marketing-paper);
    box-shadow: 0 1.5rem 4rem rgb(48 45 39 / 8%);
  }

  .cue-top,
  .cue-bottom {
    display: flex;
    height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 1.2rem;
  }

  .cue-top {
    border-bottom: 1px solid var(--cue-line-soft);
  }

  .cue-bottom {
    justify-content: space-between;
    border-top: 1px solid var(--cue-line-soft);
  }

  .cue-dot {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--marketing-accent);
  }

  .cue-dot-small {
    width: 0.35rem;
    height: 0.35rem;
    background: var(--marketing-rule);
  }

  .cue-rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--marketing-rule);
  }

  .cue-rule-short {
    width: 1rem;
  }

  .cue-rule-long {
    width: 4.5rem;
  }

  .cue-field {
    position: relative;
    min-height: 15rem;
    margin: 1.25rem;
    overflow: hidden;
    border: 1px solid var(--cue-line-soft);
    background: var(--cue-field);
  }

  .sheet {
    position: absolute;
    display: block;
    width: 42%;
    height: 69%;
    border: 1px solid var(--marketing-rule);
    background: var(--marketing-paper);
    box-shadow: 0 0.75rem 1.5rem rgb(48 45 39 / 8%);
  }

  .sheet-back {
    top: 15%;
    left: 17%;
    transform: rotate(-8deg);
  }

  .sheet-middle {
    top: 19%;
    left: 28%;
    transform: rotate(5deg);
  }

  .sheet-front {
    top: 12%;
    left: 25%;
    display: flex;
    width: 48%;
    height: 73%;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem 1.2rem;
    transform: rotate(-2deg);
  }

  .sheet-heading,
  .sheet-line {
    display: block;
    height: 0.28rem;
    background: var(--marketing-rule);
  }

  .sheet-heading {
    width: 64%;
    height: 0.48rem;
    margin-bottom: 0.35rem;
    background: var(--marketing-ink);
  }

  .sheet-line-wide {
    width: 88%;
  }

  .sheet-line-short {
    width: 48%;
  }

  .sheet-marker {
    position: absolute;
    top: 47%;
    right: 12%;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--marketing-accent);
    box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--marketing-accent) 13%, transparent);
  }

  @media (max-width: 47.99rem) {
    .workspace-cue {
      justify-self: center;
    }
  }

  @media (max-width: 36rem) {
    .workspace-cue {
      width: min(100%, 20rem);
    }

    .cue-field {
      min-height: 13rem;
    }
  }
</style>
