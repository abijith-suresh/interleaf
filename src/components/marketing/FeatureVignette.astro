---
/* A cropped page from Document view, drawn the way the editor shows it:
   saved text and checkmarks with their black dashed outline, or form fields
   with dashed edges and the selected one outlined. Decorative; the card's
   copy says the same. */
interface Props {
  kind: "text" | "field" | "check";
}

const { kind } = Astro.props;
// The editor's checkmark polyline, in a unit box with y pointing down.
const checkPoints = "0.12,0.5 0.38,0.78 0.88,0.15";
---

<div class="vignette" aria-hidden="true">
  {
    kind === "text" && (
      <div class="vignette-page">
        <i style="--w: 82%" />
        <i style="--w: 64%" />
        <span class="vignette-text">Approved for payment</span>
        <i style="--w: 74%" />
      </div>
    )
  }
  {
    kind === "field" && (
      <div class="vignette-page vignette-fields">
        <span class="vignette-label">Department</span>
        <span class="vignette-field is-selected">Facilities</span>
        <span class="vignette-label">Reference</span>
        <span class="vignette-field" />
      </div>
    )
  }
  {
    kind === "check" && (
      <div class="vignette-page vignette-checks">
        {[true, false, true].map((checked, index) => (
          <span class="vignette-check-row">
            <span class="vignette-box">
              {checked && (
                <svg class="vignette-check" viewBox="0 0 1 1">
                  <polyline points={checkPoints} />
                </svg>
              )}
            </span>
            <i style={`--w: ${[70, 54, 62][index]}%`} />
          </span>
        ))}
      </div>
    )
  }
</div>

<style>
  @reference "../../styles/global.css";

  /* A corner of the mat, as in Document view. */
  .vignette {
    --mat-x: 0px;
    --mat-y: 0px;
    @apply mat;
    padding: 0.75rem 0.75rem 0;
    overflow: hidden;
    border-radius: var(--radius-control);
  }

  /* A white PDF page, cut off at the bottom of the frame. */
  .vignette-page {
    display: grid;
    min-height: 8rem;
    align-content: center;
    justify-items: start;
    gap: 0.625rem;
    padding: 1rem 0.875rem;
    border-radius: var(--radius-page) var(--radius-page) 0 0;
    background: var(--color-white);
    box-shadow: var(--shadow-page);
    color: #000;
    font-family: Helvetica, Arial, sans-serif;
  }

  .vignette-page i {
    display: block;
    width: var(--w);
    height: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-line-strong);
  }

  /* Saved text: the editor's black dashed outline around a Helvetica line. */
  .vignette-text {
    margin-block: 0.25rem;
    font-size: 0.875rem;
    line-height: 1;
    white-space: nowrap;
    outline: 1px dashed var(--color-fg);
    outline-offset: 3px;
  }

  .vignette-fields {
    gap: 0.25rem;
  }

  .vignette-label {
    color: var(--color-fg-muted);
    font-size: 0.6875rem;
    line-height: 1rem;
  }

  .vignette-label:not(:first-child) {
    margin-top: 0.375rem;
  }

  /* A supported text field: dashed, and outlined while selected. */
  .vignette-field {
    display: flex;
    width: 100%;
    height: 1.75rem;
    align-items: center;
    padding-inline: 0.375rem;
    border: 1px dashed var(--color-fg);
    border-radius: var(--radius-page);
    font-size: 0.875rem;
  }

  .vignette-field.is-selected {
    outline: 2px solid var(--color-line-focus);
    outline-offset: 2px;
  }

  /* A flat form: printed boxes, two with saved checkmarks on top. */
  .vignette-checks {
    gap: 0.75rem;
  }

  .vignette-check-row {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.625rem;
  }

  .vignette-box {
    position: relative;
    width: 0.875rem;
    height: 0.875rem;
    flex: 0 0 auto;
    border: 1px solid #000;
  }

  .vignette-check {
    position: absolute;
    inset: -0.125rem;
    overflow: visible;
    fill: none;
    stroke: #000;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 0.1;
    outline: 1px dashed var(--color-fg);
    outline-offset: 3px;
  }
</style>
