---
import MarketingLayout from "./MarketingLayout.astro";

interface LinkPart {
  href: string;
  label: string;
  suffix?: string;
}

interface Section {
  id: string;
  num: string;
  title: string;
  body: string;
  link?: LinkPart;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  headingId: string;
  intro: string;
  sections: Section[];
}

const { title, description, heading, headingId, intro, sections } = Astro.props;
---

<MarketingLayout title={title} description={description}>
  <section class="legal-intro" aria-labelledby={headingId}>
    <div class="marketing-container">
      <div class="legal-intro-copy">
        <h1 id={headingId}>{heading}</h1>
        <p>{intro}</p>
      </div>
    </div>
  </section>

  <section class="legal-content" aria-label={`${heading} contents`}>
    <div class="legal-layout marketing-container">
      <aside class="contents-rail">
        <nav aria-label="On this page">
          <p class="contents-title">On this page</p>
          <ol>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>
                    <span>{section.num}</span>
                    {section.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="legal-article">
        {
          sections.map((section, index) => (
            <section
              id={section.id}
              class:list={["legal-block", index === sections.length - 1 && "legal-block-last"]}
            >
              <div class="legal-number">{section.num}</div>
              <div>
                <h2>{section.title}</h2>
                <p>
                  {section.body}
                  {section.link && (
                    <>
                      <a href={section.link.href} target="_blank" rel="noopener noreferrer">
                        {section.link.label}
                      </a>
                      {section.link.suffix}
                    </>
                  )}
                </p>
              </div>
            </section>
          ))
        }
      </article>
    </div>
  </section>
</MarketingLayout>

<style>
  a {
    -webkit-tap-highlight-color: rgb(255 42 31 / 18%);
    touch-action: manipulation;
  }

  a:focus-visible {
    outline: 2px solid var(--marketing-accent);
    outline-offset: 4px;
  }

  .legal-intro {
    border-bottom: 1px solid var(--marketing-rule);
    padding-block: clamp(4rem, 9vw, 6.5rem) clamp(2.75rem, 6vw, 4.5rem);
  }

  .legal-intro-copy {
    max-width: 46rem;
  }

  h1 {
    margin: 0;
    color: var(--marketing-ink);
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.085em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .legal-intro p {
    max-width: 34rem;
    margin: 1.5rem 0 0;
    color: var(--marketing-muted);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
  }

  .legal-content {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(5rem, 10vw, 8rem);
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 12rem minmax(0, 46rem);
    align-items: start;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .contents-rail {
    position: sticky;
    top: 1.5rem;
  }

  .contents-title {
    margin: 0 0 0.8rem;
    color: var(--marketing-muted);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contents-rail ol {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contents-rail a {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    min-height: 2.5rem;
    align-items: center;
    gap: 0.35rem;
    color: var(--marketing-muted);
    font-size: 0.8rem;
    line-height: 1.25;
    text-decoration: none;
  }

  .contents-rail a:hover {
    color: var(--marketing-accent);
  }

  .contents-rail a span {
    color: var(--marketing-rule-strong);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .legal-article {
    min-width: 0;
    border-top: 1px solid var(--marketing-rule-strong);
    background: var(--marketing-paper);
  }

  .legal-block {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.75rem 1.5rem 2rem;
    border-bottom: 1px solid var(--marketing-rule);
    scroll-margin-top: 1.5rem;
  }

  .legal-block-last {
    border-bottom-color: var(--marketing-rule-strong);
  }

  .legal-number {
    padding-top: 0.15rem;
    color: var(--marketing-muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  h2 {
    margin: 0;
    color: var(--marketing-ink);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .legal-block p {
    max-width: 41rem;
    margin: 0.75rem 0 0;
    color: var(--marketing-muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .legal-block a {
    color: var(--marketing-ink);
    text-decoration-color: var(--marketing-accent);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.16em;
  }

  .legal-block a:hover {
    color: var(--marketing-accent);
  }

  @media (max-width: 760px) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .contents-rail {
      position: static;
    }

    .contents-rail ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
      border-top: 1px solid var(--marketing-rule);
      padding-top: 0.5rem;
    }
  }

  @media (max-width: 520px) {
    .legal-intro {
      padding-top: 4rem;
    }

    .legal-block {
      grid-template-columns: 1.8rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 1.5rem 1rem 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
      scroll-behavior: auto;
      transition-duration: 0.01ms;
    }
  }
</style>
