---
import MarketingHero from "./MarketingHero.astro";
import MarketingLayout from "./MarketingLayout.astro";

interface LinkPart {
  href: string;
  label: string;
  suffix?: string;
}

interface Section {
  id: string;
  title: string;
  body: string;
  link?: LinkPart;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  headingId: string;
  intro: string;
  sections: Section[];
}

const { title, description, heading, headingId, intro, sections } = Astro.props;
---

<MarketingLayout title={title} description={description}>
  <MarketingHero titleId={headingId} title={heading} lede={intro} />

  <div class="reading-mat">
    <div class="marketing-container">
      <article class="reading-sheet" aria-label={`${heading} contents`}>
        {
          sections.map((section) => (
            <section id={section.id} class="reading-section">
              <h2>{section.title}</h2>
              <p>
                {section.body}
                {section.link && (
                  <>
                    <a href={section.link.href} target="_blank" rel="noopener noreferrer">
                      {section.link.label}
                    </a>
                    {section.link.suffix}
                  </>
                )}
              </p>
            </section>
          ))
        }
      </article>
    </div>
  </div>
</MarketingLayout>
