---
import MarketingHero from "./MarketingHero.astro";
import MarketingLayout from "./MarketingLayout.astro";
import MarketingSplit from "./MarketingSplit.astro";

interface LinkPart {
  href: string;
  label: string;
  suffix?: string;
}

interface Section {
  id: string;
  num: string;
  title: string;
  body: string;
  link?: LinkPart;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  headingId: string;
  intro: string;
  sections: Section[];
}

const { title, description, heading, headingId, intro, sections } = Astro.props;
---

<MarketingLayout title={title} description={description}>
  <MarketingHero titleId={headingId} title={heading} lede={intro} />

  <section class="marketing-section" aria-label={`${heading} contents`}>
    <MarketingSplit asideOnMobile={false}>
      <nav slot="aside" aria-label="On this page">
        {
          sections.map((section) => (
            <a class="marketing-link" href={`#${section.id}`}>{section.title}</a>
          ))
        }
      </nav>
      <div class="marketing-rows">
        {
          sections.map((section) => (
            <section id={section.id} class="marketing-row">
              <span class="marketing-row-marker">{section.num}</span>
              <h2 class="marketing-row-title">{section.title}</h2>
              <p class="marketing-row-body">
                {section.body}
                {section.link && (
                  <>
                    <a href={section.link.href} target="_blank" rel="noopener noreferrer">
                      {section.link.label}
                    </a>
                    {section.link.suffix}
                  </>
                )}
              </p>
            </section>
          ))
        }
      </div>
    </MarketingSplit>
  </section>
</MarketingLayout>

<style>
  nav .marketing-link {
    width: 100%;
    justify-content: flex-start;
    text-align: left;
    transition: none;
  }
</style>
