---
import MarketingLayout from "./MarketingLayout.astro";
import MarketingHero from "./MarketingHero.astro";

interface LinkPart {
  href: string;
  label: string;
  suffix?: string;
}

interface Section {
  id: string;
  num: string;
  title: string;
  body: string;
  link?: LinkPart;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  headingId: string;
  intro: string;
  sections: Section[];
}

const { title, description, heading, headingId, intro, sections } = Astro.props;
---

<MarketingLayout title={title} description={description}>
  <MarketingHero titleId={headingId}>
    <h1 slot="primary" id={headingId} class="marketing-hero-title">{heading}</h1>
    <div slot="secondary" class="legal-hero-copy">
      <p>{intro}</p>
    </div>
  </MarketingHero>

  <section class="legal-content" aria-label={`${heading} contents`}>
    <div class="legal-layout marketing-container">
      <aside class="contents-rail">
        <nav aria-label="On this page">
          <p class="contents-title">On this page</p>
          <ol>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>
                    <span>{section.num}</span>
                    {section.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <article class="legal-article">
        {
          sections.map((section) => (
            <section id={section.id} class="legal-block">
              <div class="legal-number">{section.num}</div>
              <h2>{section.title}</h2>
              <p>
                {section.body}
                {section.link && (
                  <>
                    <a href={section.link.href} target="_blank" rel="noopener noreferrer">
                      {section.link.label}
                    </a>
                    {section.link.suffix}
                  </>
                )}
              </p>
            </section>
          ))
        }
      </article>
    </div>
  </section>
</MarketingLayout>

<style>
  a {
    -webkit-tap-highlight-color: rgb(255 42 31 / 18%);
    touch-action: manipulation;
  }

  a:focus-visible {
    outline: 2px solid var(--marketing-accent);
    outline-offset: 4px;
  }

  .legal-hero-copy {
    max-width: 26rem;
  }

  .legal-hero-copy p {
    margin: 0;
    color: var(--marketing-muted);
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .legal-content {
    padding-block: clamp(3.75rem, 8vw, 6.5rem);
  }

  .legal-layout {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 7vw, 7rem);
  }

  .contents-rail {
    position: sticky;
    top: 1.5rem;
  }

  .contents-title {
    margin: 0 0 0.8rem;
    color: var(--marketing-muted);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contents-rail ol {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contents-rail a {
    position: relative;
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr);
    min-height: 2.5rem;
    align-items: center;
    gap: 0.35rem;
    color: var(--marketing-muted);
    font-size: 0.8rem;
    line-height: 1.25;
    text-decoration: none;
  }

  .contents-rail a::after {
    position: absolute;
    right: 0;
    bottom: 0.35rem;
    left: 0;
    height: 2px;
    background: var(--marketing-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 180ms var(--ease-out);
  }

  .contents-rail a:hover,
  .contents-rail a:focus-visible {
    color: var(--marketing-ink);
  }

  .contents-rail a:hover::after,
  .contents-rail a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .contents-rail a span {
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .legal-article {
    min-width: 0;
  }

  .legal-block {
    display: grid;
    grid-template-columns: 1rem minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: 1.5rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--marketing-rule);
    scroll-margin-top: 1.5rem;
  }

  .legal-block:first-child {
    border-top: 1px solid var(--marketing-ink);
  }

  .legal-number {
    margin: 0;
    color: var(--marketing-muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  h2 {
    margin: 0;
    color: var(--marketing-ink);
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .legal-block p {
    max-width: 41rem;
    margin: 0;
    color: var(--marketing-muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .legal-block a {
    color: var(--marketing-ink);
    text-decoration-color: var(--marketing-accent);
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.16em;
  }

  .legal-block a:hover {
    color: var(--marketing-accent);
  }

  @media (max-width: 56rem) {
    .legal-layout {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .contents-rail {
      position: static;
    }

    .contents-rail ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }

  @media (max-width: 48rem) {
    .legal-block {
      grid-template-columns: 1rem minmax(0, 1fr);
      gap: 0.5rem 1rem;
    }

    .legal-block p {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
      scroll-behavior: auto;
      transition-duration: 0.01ms;
    }
  }
</style>
