---
const base = import.meta.env.BASE_URL;
---

<section class="marketing-cta" aria-labelledby="closing-title">
  <div class="marketing-container marketing-cta-inner">
    <div class="marketing-cta-card">
      <div>
        <h2 id="closing-title" class="marketing-section-title">Free and open source.</h2>
        <p class="marketing-cta-copy">Nothing to install. Open the editor and add your files.</p>
      </div>
      <a class="marketing-button" href={`${base}app`}>Open editor</a>
    </div>
  </div>
</section>
