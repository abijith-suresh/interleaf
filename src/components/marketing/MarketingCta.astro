---
const base = import.meta.env.BASE_URL;
---

<section class="marketing-cta" aria-labelledby="closing-title">
  <div class="marketing-container marketing-cta-inner">
    <div>
      <h2 id="closing-title" class="marketing-section-title">Your files never leave your device.</h2>
      <p class="marketing-cta-copy">Everything runs in your browser. Nothing is uploaded.</p>
    </div>
    <a class="marketing-button" href={`${base}app`}>Open editor</a>
  </div>
</section>
