---
import Layout from "../../layouts/Layout.astro";
import { contentSlide } from "../../utils/transitions";
import Footer from "../shared/Footer.astro";
import Nav from "../shared/Nav.astro";
import MarketingCta from "./MarketingCta.astro";

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  /** The closing band above the footer. Every inner page ends with it; home has its own hero action. */
  closingCta?: boolean;
}

const { title, description, currentPage, closingCta = true } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="marketing-page">
    <Nav currentPage={currentPage} />

    <div class="marketing-content" transition:animate={contentSlide}>
      <main id="main-content">
        <slot />
        {closingCta && <MarketingCta />}
      </main>
    </div>

    <Footer />
  </div>
</Layout>

<script>
  // Astro runs this module once, so the document listener survives swaps without stacking.
  document.addEventListener("astro:after-swap", () => {
    const content = document.querySelector(".marketing-content");
    const main = content?.querySelector("main");
    if (!content || !main) return;

    content.setAttribute("data-entering", "");
    const cleanup = () => {
      content.removeAttribute("data-entering");
      main.removeEventListener("animationend", onEnd);
      window.clearTimeout(timeout);
    };
    const onEnd = (event: AnimationEvent) => {
      if (event.animationName === "marketing-enter") cleanup();
    };
    const timeout = window.setTimeout(cleanup, 300);
    main.addEventListener("animationend", onEnd);
  });
</script>
