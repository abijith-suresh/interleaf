---
import Layout from "../../layouts/Layout.astro";
import { contentSlide } from "../../utils/transitions";
import Footer from "../shared/Footer.astro";
import Nav from "../shared/Nav.astro";

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  includeMain?: boolean;
}

const { title, description, currentPage, includeMain = true } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="marketing-page">
    <Nav currentPage={currentPage} />

    <div class="marketing-content" transition:animate={contentSlide}>
      {
        includeMain ? (
          <main id="main-content">
            <slot />
          </main>
        ) : (
          <slot />
        )
      }
    </div>

    <Footer />
  </div>
</Layout>
